{
  "scenarios": [
    {
      "name": "create leaves an asset processing and classify allows it by default",
      "mock": {},
      "steps": [
        {
          "operation": "assets.create",
          "args": {
            "name": "queued.png",
            "content": {
              "base64": "aGVsbG8=",
              "type": "image/png"
            }
          },
          "save": "queued",
          "expect": {
            "result": {
              "upload.status": "completed",
              "classification.status": "processing",
              "classification.moderation.status": "pending",
              "content.status": "temporary"
            }
          }
        },
        {
          "operation": "assets.classify",
          "args": {
            "name": "analyzed.png",
            "content": {
              "base64": "aGVsbG8=",
              "type": "image/png"
            }
          },
          "expect": {
            "result": {
              "classification.status": "completed",
              "classification.moderation.status": "allowed",
              "content.status": "removed",
              "content.removalReason": "retention"
            }
          }
        },
        {
          "operation": "assets.retrieve",
          "args": {
            "assetId": {
              "$ref": "queued.id"
            }
          },
          "expect": {
            "result": {
              "id": {
                "$ref": "queued.id"
              },
              "classification.moderation.status": "pending"
            }
          }
        }
      ]
    },
    {
      "name": "classify uses analyzedOutcome and create uses queuedOutcome",
      "mock": {
        "queuedOutcome": "allowed",
        "analyzedOutcome": "blocked"
      },
      "steps": [
        {
          "operation": "assets.classify",
          "args": {
            "name": "analyzed.png",
            "content": {
              "base64": "aGVsbG8=",
              "type": "image/png"
            }
          },
          "expect": {
            "result": {
              "classification.status": "completed",
              "classification.moderation.status": "blocked"
            }
          }
        },
        {
          "operation": "text.classify",
          "args": {
            "text": "hello"
          },
          "expect": {
            "result": {
              "classification.moderation.status": "blocked"
            }
          }
        },
        {
          "operation": "assets.create",
          "args": {
            "name": "queued.png",
            "content": {
              "base64": "aGVsbG8=",
              "type": "image/png"
            }
          },
          "expect": {
            "result": {
              "classification.status": "completed",
              "classification.moderation.status": "allowed"
            }
          }
        }
      ]
    },
    {
      "name": "a reviewer's block shows in retrieve, list, filters and events, and stops delivery",
      "mock": {
        "apiKeyGrants": [
          {
            "actions": [
              "assets:download"
            ],
            "folderId": null,
            "includeSubfolders": true
          }
        ]
      },
      "steps": [
        {
          "operation": "events.list",
          "args": {},
          "save": "feed",
          "expect": {
            "result": {
              "events.length": 0,
              "hasMore": false
            }
          }
        },
        {
          "operation": "assets.classify",
          "args": {
            "name": "blocked.png",
            "content": {
              "base64": "aGVsbG8=",
              "type": "image/png"
            },
            "processingOptions": {
              "keepContentAfterProcessing": true
            }
          },
          "save": "blocked",
          "expect": {
            "result": {
              "classification.moderation.status": "allowed"
            }
          }
        },
        {
          "operation": "assets.classify",
          "args": {
            "name": "other.png",
            "content": {
              "base64": "aGVsbG8=",
              "type": "image/png"
            },
            "processingOptions": {
              "keepContentAfterProcessing": true
            }
          },
          "save": "other"
        },
        {
          "operation": "mock.decide",
          "args": {
            "assetId": {
              "$ref": "blocked.id"
            },
            "outcome": "blocked"
          },
          "expect": {
            "result": {
              "id": {
                "$ref": "blocked.id"
              },
              "classification.moderation.status": "blocked",
              "content.status": "stored"
            }
          }
        },
        {
          "operation": "assets.retrieve",
          "args": {
            "assetId": {
              "$ref": "blocked.id"
            }
          },
          "expect": {
            "result": {
              "classification.moderation.status": "blocked"
            }
          }
        },
        {
          "operation": "assets.list",
          "args": {
            "filter": "classification.moderation.status==blocked"
          },
          "expect": {
            "result": {
              "items.length": 1,
              "items.0.id": {
                "$ref": "blocked.id"
              }
            }
          }
        },
        {
          "operation": "assets.list",
          "args": {
            "filter": "classification.moderation.status==allowed"
          },
          "expect": {
            "result": {
              "items.length": 1,
              "items.0.id": {
                "$ref": "other.id"
              }
            }
          }
        },
        {
          "operation": "assets.list",
          "args": {},
          "expect": {
            "result": {
              "items.length": 2
            }
          }
        },
        {
          "operation": "cdn.serve",
          "args": {
            "assetIdentifier": {
              "$ref": "blocked.id"
            },
            "resource": "original"
          },
          "expect": {
            "cdn": {
              "status": 403,
              "code": "asset/not-available"
            }
          }
        },
        {
          "operation": "cdn.serve",
          "args": {
            "assetIdentifier": {
              "$ref": "other.id"
            },
            "resource": "original"
          },
          "expect": {
            "cdn": {
              "status": 200,
              "body": "hello"
            }
          }
        },
        {
          "operation": "events.list",
          "args": {
            "after": {
              "$ref": "feed.cursor"
            }
          },
          "expect": {
            "result": {
              "events.length": 1,
              "events.0.type": "asset.blocked",
              "events.0.severity": "high",
              "events.0.assetId": {
                "$ref": "blocked.id"
              },
              "events.0.asset.classification.moderation.status": "blocked",
              "events.0.facts": {
                "$contains": {
                  "key": "decided-by",
                  "value": "reviewer"
                }
              }
            }
          }
        }
      ]
    },
