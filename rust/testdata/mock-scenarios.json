    {
      "name": "keepContentAfterProcessing keeps content until it is deleted",
      "mock": {
        "apiKeyGrants": [
          {
            "actions": [
              "assets:download"
            ],
            "folderId": null,
            "includeSubfolders": true
          }
        ]
      },
      "steps": [
        {
          "operation": "assets.classify",
          "args": {
            "name": "kept.png",
            "content": {
              "base64": "aGVsbG8=",
              "type": "image/png"
            },
            "processingOptions": {
              "keepContentAfterProcessing": true
            }
          },
          "save": "kept",
          "expect": {
            "result": {
              "content.status": "stored",
              "content.removalReason": null
            }
          }
        },
        {
          "operation": "cdn.serve",
          "args": {
            "assetIdentifier": {
              "$ref": "kept.id"
            },
            "resource": "original"
          },
          "expect": {
            "cdn": {
              "status": 200,
              "body": "hello"
            }
          }
        },
        {
          "operation": "assets.classify",
          "args": {
            "name": "temporary.png",
            "content": {
              "base64": "aGVsbG8=",
              "type": "image/png"
            }
          },
          "save": "temporary",
          "expect": {
            "result": {
              "content.status": "removed",
              "content.removalReason": "retention"
            }
          }
        },
        {
          "operation": "cdn.serve",
          "args": {
            "assetIdentifier": {
              "$ref": "temporary.id"
            },
            "resource": "original"
          },
          "expect": {
            "cdn": {
              "status": 403,
              "code": "asset/not-available"
            }
          }
        },
        {
          "operation": "assets.deleteContent",
          "args": {
            "assetId": {
              "$ref": "kept.id"
            }
          },
          "expect": {
            "result": {
              "content.status": "removed",
              "content.removalReason": "requested",
              "classification.moderation.status": "allowed"
            }
          }
        },
        {
          "operation": "cdn.serve",
          "args": {
            "assetIdentifier": {
              "$ref": "kept.id"
            },
            "resource": "original"
          },
          "expect": {
            "cdn": {
              "status": 403,
              "code": "asset/not-available"
            }
          }
        }
      ]
    },
