{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "src/react",
    "src/elements.ts",
    "src/playground.ts",
    "src/main.ts",
    "src/vite-env.d.ts",
    "src/shims.d.ts",
    "server",
    "vite.config.ts"
  ]
}
