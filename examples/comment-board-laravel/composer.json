{
  "name": "calmlens/example-comment-board",
  "description": "Laravel comment moderation example using the CalmLens PHP SDK",
  "type": "project",
  "license": "MIT",
  "require": {"php": "^8.2", "calmlens/sdk": "dev-main", "laravel/framework": "^12.0"},
  "require-dev": {"phpunit/phpunit": "^11.5", "mockery/mockery": "^1.6"},
  "repositories": [{"type": "path", "url": "../../php", "options": {"symlink": true, "versions": {"calmlens/sdk": "dev-main"}}}],
  "autoload": {"psr-4": {"App\\": "app/"}},
  "scripts": {"test": "phpunit"},
  "config": {"sort-packages": true, "platform": {"php": "8.2.0"}}
