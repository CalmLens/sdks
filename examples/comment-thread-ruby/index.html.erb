<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= h @post[:title] %> · Calmthread</title>
<style>
:root{--ink:#24212e;--soft:#5f5a70;--line:#e6e3ee;--page:#f8f7fb;--card:#fff;--accent:#4b3f8f;--accent-ink:#fff;--held:#fff8e6;--held-line:#ecd9a6;--held-ink:#6b4d0f;--gone:#f6f4f8;--ok:#2f6a3a;--bad:#8a3a32;
font-family:system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink);background:var(--page);line-height:1.55}
*{box-sizing:border-box}body{margin:0}a{color:var(--accent)}
.top{background:var(--card);border-bottom:1px solid var(--line)}.top div{max-width:1120px;margin:auto;padding:14px 24px;display:flex;align-items:center;gap:24px}
.wordmark{font-weight:700;font-size:18px;letter-spacing:-.3px}.top nav{font-size:14px;color:var(--soft)}.demo-note{margin-left:auto;font-size:13px;color:var(--soft)}
.page{max-width:1120px;margin:auto;padding:32px 24px 56px;display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:40px;align-items:start}
.notice{padding:12px 16px;border:1px solid var(--line);background:var(--card);border-radius:10px;margin-bottom:20px;font-size:15px}
.post{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:22px 26px}
.post h1{font-size:26px;line-height:1.25;letter-spacing:-.4px;margin:0 0 14px}
.post .body{font-size:16px;margin:14px 0 0}
.byline{display:flex;align-items:center;gap:10px;font-size:14px;min-width:0}.byline strong{font-weight:650;overflow-wrap:anywhere}.byline span{color:var(--soft)}
.avatar{flex:none;width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:650;font-size:14px}
.t0{background:#e9e4f7;color:#4b3f8f}.t1{background:#dff0ea;color:#285e4b}.t2{background:#fbe7dc;color:#86452a}.t3{background:#e2ecf8;color:#2d4f7c}.t4{background:#f4e6f0;color:#7a3566}.t5{background:#ece9df;color:#5c5233}
.avatar.empty{background:var(--line);color:var(--soft)}
.body{white-space:pre-wrap;overflow-wrap:anywhere;margin:4px 0 0 44px}
.replies-head{font-size:15px;font-weight:650;margin:24px 0 2px}
.replies{list-style:none;margin:0;padding:0}
.reply{padding:14px 0;border-bottom:1px solid var(--line)}
.reply .meta{color:var(--soft);font-size:13px}
.reply.held{background:var(--held);border:1px solid var(--held-line);border-radius:12px;padding:16px 18px;margin:12px 0}
.reply.removed{background:var(--gone);border:1px solid var(--line);border-radius:12px;padding:16px 18px;margin:12px 0}
.status{margin:10px 0 0 44px;font-size:14px}.held .status{color:var(--held-ink)}.removed .status{color:var(--soft)}
.status strong{font-weight:650}.reviewed{color:var(--ok)}
.test-input{font-size:12px;border:1px solid var(--line);border-radius:6px;padding:1px 6px;color:var(--soft);background:var(--card);white-space:nowrap}
.empty-thread{color:var(--soft);padding:18px 0;margin:0}
.composer{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px 22px;margin-top:24px}
.composer h2{font-size:16px;margin:0 0 12px}.fields{display:grid;grid-template-columns:240px 1fr;gap:12px}
label{display:block;font-size:13px;font-weight:600;margin:0 0 6px}
input,textarea,select{font:inherit;width:100%;border:1px solid #cfcadd;border-radius:8px;padding:9px 11px;background:#fff;color:var(--ink)}
textarea{min-height:96px;resize:vertical}.reply-label{margin-top:12px}
.composer .row{display:flex;align-items:end;gap:12px;margin-top:12px}.composer .row .grow{flex:1}
button{font:inherit;font-weight:600;border-radius:8px;padding:9px 16px;border:1px solid var(--accent);background:var(--accent);color:var(--accent-ink);cursor:pointer}
button:hover{background:#3b3173}button.quiet{background:var(--card);color:var(--accent);border-color:#cfcadd;padding:6px 12px;font-size:13px}button.quiet:hover{background:#f3f0fb}
:focus-visible{outline:3px solid #bd8725;outline-offset:2px}
.rail section{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px 20px;margin-bottom:16px}
.rail h2{font-size:15px;margin:0}.rail .sub{font-size:13px;color:var(--soft);margin:4px 0 12px}
.rail ol{list-style:none;margin:0;padding:0}.rail li{border-top:1px solid var(--line);padding:10px 0;font-size:14px;overflow-wrap:anywhere}.rail li:first-child{border-top:0;padding-top:0}
.rail time{display:block;font-size:12px;color:var(--soft)}
.rail dl{display:grid;grid-template-columns:auto 1fr;gap:1px 10px;margin:6px 0 0;font-size:12px;color:var(--soft)}.rail dt{font-weight:600}.rail dd{margin:0}
.actions{display:flex;gap:8px;margin-top:8px}.actions form{margin:0}
.kind-held{color:var(--held-ink)}.kind-removed,.kind-failed{color:var(--bad)}.kind-released{color:var(--ok)}
.sync{margin-top:14px;padding-top:14px;border-top:1px solid var(--line)}.sync p{font-size:13px;color:var(--soft);margin:0 0 10px}
@media(max-width:860px){.page{grid-template-columns:1fr}.fields{grid-template-columns:1fr}.body,.status{margin-left:0}}
</style></head><body>
<header class="top"><div><span class="wordmark">Calmthread</span><nav aria-label="Community">Everyday living</nav>
<%- if @demo -%><span class="demo-note">Demo mode: moderation outcomes are simulated</span><%- end -%></div></header>
<main class="page">
<div class="thread">
<%- unless @notice.empty? -%>
<div class="notice" role="status"><%= h @notice %></div>
<%- end -%>
<article class="post" aria-labelledby="post-title">
<h1 id="post-title"><%= h @post[:title] %></h1>
<div class="byline"><span class="avatar t<%= tone(@post[:author]) %>" aria-hidden="true"><%= h initial(@post[:author]) %></span><strong><%= h @post[:author] %></strong><span><%= h @post[:role] %> · <%= h @post[:posted] %></span></div>
<p class="body"><%= h @post[:body] %></p>
</article>
<section aria-labelledby="replies-heading">
<%- published = @replies.count { |reply| reply[:state] == :published } -%>
<h2 class="replies-head" id="replies-heading"><%= published %> <%= published == 1 ? 'reply' : 'replies' %></h2>
<%- if @replies.empty? -%>
<p class="empty-thread">No replies yet. Be the first to share yours.</p>
<%- end -%>
<ol class="replies">
<%- @replies.each do |reply| -%>
<%- if reply[:state] == :removed -%>
<li class="reply removed" aria-label="Your removed reply">
<div class="byline"><span class="avatar empty" aria-hidden="true">–</span><strong>Your reply was removed</strong><span><%= h ago(reply[:created_at]) %></span></div>
<p class="status">A moderator reviewed it and kept it out of the thread<%= reply[:flagged].empty? ? '' : ": flagged for #{h reasons(reply)}" %>. Its text has been deleted.</p>
</li>
<%- elsif reply[:state] == :held -%>
<li class="reply held" aria-label="Your reply, awaiting review">
<div class="byline"><span class="avatar t<%= tone(reply[:name]) %>" aria-hidden="true"><%= h initial(reply[:name]) %></span><strong><%= h reply[:name] %></strong><span>You · <%= h ago(reply[:created_at]) %></span></div>
<p class="body"><%= body_html(reply[:text]) %></p>
<p class="status"><strong>Awaiting review.</strong> Only you can see this reply until a moderator approves it. <%= h flag_summary(reply) %>.</p>
</li>
<%- else -%>
<li class="reply">
<div class="byline"><span class="avatar t<%= tone(reply[:name]) %>" aria-hidden="true"><%= h initial(reply[:name]) %></span><strong><%= h reply[:name] %></strong><span><%= mine?(reply) ? 'You · ' : '' %><%= h ago(reply[:created_at]) %><%- if reply[:review] -%> · <span class="reviewed">Approved after review</span><%- end -%></span></div>
<p class="body"><%= body_html(reply[:text]) %></p>
</li>
<%- end -%>
<%- end -%>
</ol>
</section>
<form class="composer" action="/replies" method="post" aria-labelledby="composer-heading"><input type="hidden" name="csrf" value="<%= h @csrf %>">
<h2 id="composer-heading">Add a reply</h2>
<div class="fields"><div><label for="name">Your name</label><input id="name" name="name" maxlength="<%= @max_name %>" required autocomplete="nickname"></div></div>
<label for="text" class="reply-label">Reply</label><textarea id="text" name="text" maxlength="<%= @max_text %>" required></textarea>
<div class="row">
<%- if @demo -%>
<div class="grow"><label for="demo_result">Demo outcome</label><select id="demo_result" name="demo_result">
<%- @demo_results.each do |value, label| -%>
<option value="<%= h value %>"><%= h label %></option>
<%- end -%>
</select></div>
<%- else -%><div class="grow"></div><%- end -%>
<button type="submit">Post reply</button>
</div>
</form>
</div>
<aside class="rail" aria-label="Moderation">
<section aria-labelledby="queue-heading"><h2 id="queue-heading">Review queue</h2>
<p class="sub"><%= @held.empty? ? 'Nothing is waiting for a moderator.' : "#{@held.size} #{@held.size == 1 ? 'reply is' : 'replies are'} hidden until a moderator decides in CalmLens." %></p>
<%- unless @held.empty? -%>
<ol>
<%- @held.each do |reply| -%>
<li><time><%= h ago(reply[:created_at]) %></time><%= h flag_summary(reply) %>
<%- if @demo -%>
<div class="actions">
<form action="/demo/review" method="post"><input type="hidden" name="csrf" value="<%= h @csrf %>"><input type="hidden" name="reply" value="<%= h reply[:id] %>"><input type="hidden" name="decision" value="allow"><button class="quiet" type="submit">Approve</button></form>
<form action="/demo/review" method="post"><input type="hidden" name="csrf" value="<%= h @csrf %>"><input type="hidden" name="reply" value="<%= h reply[:id] %>"><input type="hidden" name="decision" value="block"><button class="quiet" type="submit">Reject</button></form>
</div>
<%- end -%>
</li>
<%- end -%>
</ol>
<%- end -%>
<%- unless @demo -%>
<form class="sync" action="/reviews/sync" method="post"><input type="hidden" name="csrf" value="<%= h @csrf %>"><p><%= @webhooks ? 'Decisions arrive by verified webhook. You can also read the events feed now.' : 'Decisions are read from the events feed.' %></p><button class="quiet" type="submit">Check for decisions</button></form>
<%- end -%>
</section>
<section aria-labelledby="log-heading"><h2 id="log-heading">Moderation log</h2>
<%- if @activity.empty? -%>
<p class="sub">Nothing yet.</p>
<%- else -%>
<ol>
<%- @activity.first(8).each do |entry| -%>
<li class="kind-<%= h entry[:kind] %>"><time><%= h ago(entry[:at]) %><%= entry[:via] ? " · #{h Calmthread::ReviewFeed::SOURCES[entry[:via]]}" : '' %></time><%= h entry[:text] %>
<%- unless entry[:facts].empty? -%>
<dl><%- entry[:facts].each do |fact| -%><dt><%= h fact[:label] %></dt><dd><%- if fact[:url] -%><a href="<%= h fact[:url] %>" rel="noopener noreferrer"><%= h fact[:value] %></a><%- else -%><%= h fact[:value] %><%- end -%></dd><%- end -%></dl>
<%- end -%>
</li>
<%- end -%>
</ol>
<%- end -%>
</section>
</aside>
</main></body></html>
