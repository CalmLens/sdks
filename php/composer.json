{
  "name": "calmlens/sdk",
  "description": "CalmLens PHP SDK for moderation, storage, events and CDN delivery",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-hash": "*",
    "ext-json": "*",
    "guzzlehttp/psr7": "^2.7 || ^3.0",
    "php-http/discovery": "^1.19",
    "psr/http-client": "^1.0",
    "psr/http-message": "^2.0",
    "psr/log": "^2.0 || ^3.0"
  },
  "require-dev": {
    "guzzlehttp/guzzle": "^7.9 || ^8.0",
    "phpstan/phpdoc-parser": "^2.3",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "suggest": {
    "guzzlehttp/guzzle": "The HTTP client the SDK uses when none is passed, with per-attempt timeouts; any PSR-18 client works"
  },
  "autoload": {
    "psr-4": {
      "CalmLens\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "check": [
      "@php scripts-check.php",
      "phpstan analyse --configuration=tests/phpstan.neon --no-progress --memory-limit=1G"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": false
    }
  },
  "archive": {
    "exclude": [
      "/tests",
      "/scripts-check.php",
      "/phpunit.xml",
      "/package.json",
      "/.phpunit.cache",
      "/vendor",
      "/composer.lock"
    ]
  }
}
