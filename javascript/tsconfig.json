{
  "compilerOptions": {
    "rootDir": ".",
    "lib": ["es2022", "dom"],
    "allowJs": true,
    "strict": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "declaration": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": ["node", "bun"]
  },
  "include": ["src"],
  "exclude": ["bin", "esm", "cjs", "src/svelte"]
}
