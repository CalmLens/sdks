{
  "name": "@calmlens/sdk",
  "version": "0.16.3",
  "description": "Official CalmLens SDK for JavaScript and TypeScript: content moderation, asset storage and CDN delivery.",
  "license": "MIT",
  "homepage": "https://calmlens.com/docs/sdk/javascript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CalmLens/sdks.git",
    "directory": "javascript"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "cjs/index.js",
  "types": "cjs/index.d.ts",
  "module": "esm/index.js",
  "sideEffects": [
    "./esm/elements.js",
    "./cjs/elements.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepublishOnly": "npm run check && npm run test && npm run build",
    "test": "bun test --parallel=4 ./tests/",
    "check:fix": "tsc --noEmit --project tsconfig.json && npx @biomejs/biome check --write",
    "check": "tsc --noEmit --project tsconfig.json && npx @biomejs/biome check",
    "cleanup": "rimraf esm && rimraf cjs && rimraf bin",
    "build": "npm run cleanup && rolldown -c rolldown.config.mjs && node scripts/post-build.js && npm run verify:package",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "keywords": [
    "calmlens",
    "content-moderation",
    "moderation",
    "image-moderation",
    "text-moderation",
    "trust-and-safety",
    "webhooks",
    "cdn",
    "sdk",
    "typescript"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "esm/",
    "cjs/"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@oxc-project/runtime": "0.148.0",
    "@types/bun": "^1.4.2",
    "@types/node": "26.6.1",
    "@types/react": "19.2.2",
    "rimraf": "6.1.3",
    "rolldown": "1.2.13",
    "rolldown-plugin-dts": "0.28.7",
    "svelte": "5.41.0",
    "typescript": "7.0.2",
    "vue": "3.5.22"
  },
  "dependencies": {
    "zod": "^4.6.5",
    "json-schema-to-ts": "^3.1.1"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      },
      "require": {
        "types": "./cjs/index.d.ts",
        "default": "./cjs/index.js"
      },
      "default": "./esm/index.js"
    },
    "./server": {
      "import": {
        "types": "./esm/server.d.ts",
        "default": "./esm/server.js"
      },
      "require": {
        "types": "./cjs/server.d.ts",
        "default": "./cjs/server.js"
      },
      "default": "./esm/server.js"
    },
    "./app": {
      "import": {
        "types": "./esm/app.d.ts",
        "default": "./esm/app.js"
      },
      "require": {
        "types": "./cjs/app.d.ts",
        "default": "./cjs/app.js"
      },
      "default": "./esm/app.js"
    },
    "./ui": {
      "import": {
        "types": "./esm/ui.d.ts",
        "default": "./esm/ui.js"
      },
      "require": {
        "types": "./cjs/ui.d.ts",
        "default": "./cjs/ui.js"
      },
      "default": "./esm/ui.js"
    },
    "./react": {
      "import": {
        "types": "./esm/react.d.ts",
        "default": "./esm/react.js"
      },
      "require": {
        "types": "./cjs/react.d.ts",
        "default": "./cjs/react.js"
      },
      "default": "./esm/react.js"
    },
    "./vue": {
      "import": {
        "types": "./esm/vue.d.ts",
        "default": "./esm/vue.js"
      },
      "require": {
        "types": "./cjs/vue.d.ts",
        "default": "./cjs/vue.js"
      },
      "default": "./esm/vue.js"
    },
    "./svelte": {
      "types": "./esm/svelte/index.d.ts",
      "svelte": "./esm/svelte/index.js",
      "default": "./esm/svelte/index.js"
    },
    "./elements": {
      "import": {
        "types": "./esm/elements.d.ts",
        "default": "./esm/elements.js"
      },
      "require": {
        "types": "./cjs/elements.d.ts",
        "default": "./cjs/elements.js"
      },
      "default": "./esm/elements.js"
    },
    "./styles.css": "./esm/styles.css",
    "./testing": {
      "import": {
        "types": "./esm/testing.d.ts",
        "default": "./esm/testing.js"
      },
      "require": {
        "types": "./cjs/testing.d.ts",
        "default": "./cjs/testing.js"
      },
      "default": "./esm/testing.js"
    },
    "./package.json": "./package.json",
    "./test-inputs": {
      "import": {
        "types": "./esm/test-inputs.d.ts",
        "default": "./esm/test-inputs.js"
      },
      "require": {
        "types": "./cjs/test-inputs.d.ts",
        "default": "./cjs/test-inputs.js"
      },
      "default": "./esm/test-inputs.js"
    }
  },
  "bugs": {
    "url": "https://github.com/CalmLens/sdks/issues"
  },
  "peerDependencies": {
    "react": ">=18",
    "svelte": ">=5",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
