# Enums and option shapes of the CalmLens API, mirroring the Zod schemas in packages/shared/src.
# Results are model classes, generated in sig/models.rbs.
#
# Options (`*_input`) are snake_case Symbol keys; nested ones may also take the API's camelCase
# String keys, as a result's `to_h` gives them. Fields marked optional (`?key:`) can be left out;
# `T?` values can be null.
module CalmLens
  # Any JSON value the API returns where it allows arbitrary JSON (metadata values, error details).
  type json_value = String | Integer | Float | bool | nil | Array[json_value] | Hash[String, json_value]
  # Any value the SDK can encode as JSON.
  type json_input = String | Integer | Float | bool | nil | Array[json_input] | Hash[String | Symbol, json_input]
  # A JSON number: whole numbers parse as Integer, others as Float.
  type number = Integer | Float

  # Per-call settings every method accepts under `request_options:`.
  type request_options = {
    ?idempotency_key: String,
    ?timeout: number,
    ?open_timeout: number,
    ?upload_timeout: number,
    ?max_retries: Integer,
    ?max_response_bytes: Integer,
    # Extra headers; the client's API key and user agent can't be replaced.
    ?headers: Hash[String, String],
    # Query parameters and JSON body fields added to the request, for API fields this release lacks.
    ?extra_query: Hash[String | Symbol, untyped],
    ?extra_body: Hash[String | Symbol, untyped]
  }

  # ---- Assets (Asset.ts) ----------------------------------------------------------------------

  # Where the asset is in the pipeline: `queued` while it waits for its content (a multipart upload
  # still receiving parts) or its turn, `processing`, then `completed` or `failed`. The asset is
  # settled once it is `completed` or `failed`.
  type asset_classification_status = "queued" | "processing" | "completed" | "failed"
  # A moderation decision, which also decides delivery: served to anyone with access (`allowed`),
  # served like `allowed` but marked so your app reduces its reach (`limited`), only through signed
  # URLs or API keys (`age-restricted`), not served (`blocked`), or not served with the stored
  # content deleted (`purged`).
  type asset_moderation_decision = "allowed" | "limited" | "age-restricted" | "blocked" | "purged"
  # Whether CalmLens holds the content: only until processing finishes, retained, or deleted.
  type asset_content_status = "temporary" | "stored" | "removed"
  type asset_content_removal_reason = "policy" | "retention" | "requested" | "parent-removed" | "disposed"
  # Why processing failed, while the classification status is `failed`.
  type asset_classification_failure_reason = "file-too-large" | "duration-limit" | "resolution-limit" | "unsupported-format" | "undecodable-content" | "multiple-tracks" | "type-mismatch" | "free-uploads-exhausted" | "media-limit" | "uploads-paused" | "too-many-items" | "processing-error"
  type asset_type = "image" | "video" | "audio" | "plaintext-document" | "multimedia-document" | "website" | "file"
  type asset_visibility = "public" | "private"
  # FLAGGED_CONTENT_ACTION_SCHEMA in PolicyRule.ts.
  type flagged_content_action = "allow" | "limit" | "age-restrict" | "block" | "purge"

  # A metadata item to send. Keys inside `metadata` are sent unchanged, so use `id:` and `value:`.
  type metadata_item_input = { id: String, value: json_input }
  # An earlier post in the conversation, as the API returns it.
  type moderation_context_item = { "text" => String, ?"authorId" => String }
  # An earlier post to send. `author_id` is your identifier for who wrote it.
  type moderation_context_item_input = { text: String, ?author_id: String }
  # Earlier posts to send, oldest first; only the posts CalmLens uses are sent.
  type moderation_context_input = { items: Array[moderation_context_item_input] }

  # ProcessingFeatures.ts: optional analyses to run, keyed by feature. Link detection runs unless
  # `enabled` is false; every other feature is off unless `enabled` is true.
  type processing_features_input = {
    ?ocr: { enabled: bool }?,
    ?person_detection: { enabled: bool }?,
    ?face_detection: { enabled: bool, ?age_estimation: bool }?,
    ?link_detection: { enabled: bool }?,
    # Preview. Prepares an adaptive stream (HLS) of audio or video, served at the `hls` resource and
    # played by the `embed` resource; needs `retain_content`. Left out, the project's
    # streaming setting decides.
    ?streaming: { enabled: bool }?
  }
  type processing_options_input = {
    ?retain_content: bool?,
    # Overrides the project's `storeSensitiveMetadata` setting: false removes embedded EXIF, XMP and
    # IPTC metadata before the image is stored; true stores it as uploaded.
    ?store_sensitive_metadata: bool?,
    ?features: processing_features_input?
  }

  # Why there is no stream: the streaming allowance is used up, billing or the spend limit stops it,
  # preparing it failed, or the content was not kept.
  type asset_hls_unavailable_reason = "allowance-used" | "billing-required" | "spend-limit" | "processing-failed" | "content-not-kept"
  type asset_rendered_kind = "image" | "pdf" | "video" | "audio"

  # The regions whose laws set mandatory delivery rules.
  type moderation_region = "DE" | "AT" | "FR" | "GB" | "EU" | "AU" | "BR"

  # ---- Moderation report (Classification.ts, ProcessingFeatures.ts) ----------------------------

  type likelihood = "very-unlikely" | "unlikely" | "possible" | "likely" | "very-likely"
  # not-supported: this processing path cannot assess the signal; unavailable: assessment failed.
  type not_evaluated_reason = "not-supported" | "unavailable"
  # A processing feature's reason, which adds in-children: a document's or website's images are each
  # a child asset with its own result (`assets.list_children`).
  type feature_not_evaluated_reason = not_evaluated_reason | "in-children"
  type classification_category = "sexual" | "violence" | "self-harm" | "harassment" | "hate" | "criminal-activity"
                                | "personal-information" | "profanity"

  # One qualifier's result, the values of qualifiers.rbs's qualifier_results (written by
  # packages/sdk-contract/generate.ts). Results read them as {QualifierResult} models.
  type qualifier_result = {
    "status" => "evaluated" | "not-evaluated",
    ?"someScore" => number,
    ?"allScore" => number,
    ?"likelihood" => likelihood,
    ?"reason" => not_evaluated_reason
  }

  # What a link does to its asset, weakest first. Purging content over a link is never offered.
  type link_safety_action = "allow" | "limit" | "age-restrict" | "block"

  # ---- Pages and search (Page.ts, AssetSearch.ts) --------------------------------------------

  # A list's sort: comma-separated fields, each ascending unless prefixed with `-`, such as
  # `-createdAt,id`.
  type sort = String

  type asset_search_mode = "keyword" | "semantic" | "hybrid"
  type asset_search_match_field = "name" | "id" | "externalId" | "description" | "tags" | "type" | "content.format" |
                                  "content.extension" | "classification.moderation.decision" | "visual" | "transcript"

  type asset_batch_operation = "delete" | "remove-content"
  # Whether the viewer an asset URL's claims describe can see the content now.
  type asset_availability = "available" | "age-restricted" | "unavailable"

  # ---- Transforms and lenses (AssetTransform.ts, Lens.ts) -------------------------------------

  # <generated: image-transform-options>
  # Generated by packages/sdk-contract/generate.ts from IMAGE_TRANSFORM_OPTIONS_SCHEMA; do not edit.
  type image_format = "jpg" | "png" | "webp" | "avif" | "gif"
  type image_quality_level = "low" | "medium" | "high"
  type image_fit = "scale-down" | "contain" | "pad" | "squeeze" | "cover" | "crop"
  type image_flip = "h" | "v" | "hv"
  type image_segment = "foreground"
  type image_gravity_side = "face" | "left" | "right" | "top" | "bottom" | "center" | "auto" | "entropy"
  type image_gravity_mode = "remainder" | "box-center"

  # IMAGE_TRANSFORM_OPTIONS_SCHEMA, as options to send.
  type image_transform_options_input = {
    ?format: image_format,
    ?width: Integer,
    ?height: Integer,
    ?dpr: number,
    ?anim: bool,
    ?background: String,
    ?blur: number,
    ?border: {
      ?color: String,
      ?width: number
    },
    ?brightness: number,
    ?contrast: number,
    ?quality: Integer | image_quality_level,
    ?fit: image_fit,
    ?flip: image_flip,
    ?gamma: number,
    ?segment: image_segment,
    ?gravity: image_gravity_side | {
      mode: image_gravity_mode,
      ?x: number,
      ?y: number
    },
    ?rotate: 0 | 90 | 180 | 270,
    ?saturation: number,
    ?sharpen: number,
    ?trim: "border" | {
      ?top: number,
      ?bottom: number,
      ?left: number,
      ?right: number,
      ?width: number,
      ?height: number,
      ?border: bool | {
        ?color: String,
        ?tolerance: number,
        ?keep: number
      }
    }
  }
  # IMAGE_TRANSFORM_OPTIONS_SCHEMA, as the API returns it in a lens.
  type image_transform_options = {
    ?"format" => image_format,
    ?"width" => Integer,
    ?"height" => Integer,
    ?"dpr" => number,
    ?"anim" => bool,
    ?"background" => String,
    ?"blur" => number,
    ?"border" => {
      ?"color" => String,
      ?"width" => number
    },
    ?"brightness" => number,
    ?"contrast" => number,
    ?"quality" => Integer | image_quality_level,
    ?"fit" => image_fit,
    ?"flip" => image_flip,
    ?"gamma" => number,
    ?"segment" => image_segment,
    ?"gravity" => image_gravity_side | {
      "mode" => image_gravity_mode,
      ?"x" => number,
      ?"y" => number
    },
    ?"rotate" => 0 | 90 | 180 | 270,
    ?"saturation" => number,
    ?"sharpen" => number,
    ?"trim" => "border" | {
      ?"top" => number,
      ?"bottom" => number,
      ?"left" => number,
      ?"right" => number,
      ?"width" => number,
      ?"height" => number,
      ?"border" => bool | {
        ?"color" => String,
        ?"tolerance" => number,
        ?"keep" => number
      }
    }
  }
  # </generated: image-transform-options>

  # Transform options applied in one pass: a selector String such as `width=1024,fit=cover`, or
  # structured options, which the SDK serializes into a selector.
  type transform_input = String | image_transform_options_input

  type lens_type = "image" | "video" | "audio" | "document" | "website"
  # ENSURE_LENS_BODY_SCHEMA: a lens definition, which the CDN serves once it is saved unless `active` is false.
  type lens_definition = {
    identifier: String,
    name: String,
    type: lens_type,
    ?active: bool,
    ?description: String?,
    ?transform: image_transform_options_input?
  }

  # ---- Configuration as data (UploadPreset.ts, ProjectConfiguration.ts) --------------------------

  type upload_preset_access = "token" | "anyone"

  # Jurisdictions a project can opt out of serving.
  type opt_out_jurisdiction = "EU"

  type metadata_field_type = "string" | "number" | "boolean" | "date" | "url"
  type metadata_field_icon = "tag" | "hash" | "user" | "folder" | "layers" | "photo" | "link"

  # ---- Folders (Folder.ts) --------------------------------------------------------------------

  # ---- Hash lists (HashList.ts) ----------------------------------------------------------------

  type hash_list_action = "flag" | "block"

  # ---- Policies (Policy.ts) ---------------------------------------------------------------------

  type policy_preset_id = "general-community" | "children-platform" | "education-support" | "wholesome-community"
  # How a policy relates to its preset: `live` follows the latest release (the organisation's own
  # preset policy with automatic updates on), `pinned` is the organisation's own preset policy held
  # at one release, and `copy` is a policy made from a preset.
  type policy_preset_mode = "live" | "pinned" | "copy"

  # ---- Events and webhooks (Event.ts, EventCatalog.ts, WebhookPayload.ts) ----------------------

  type event_severity = "low" | "high"
  # A registered fact's value: text, an enum value, a count or a time in milliseconds (such as
  # `resumes-at`), a list of enum values (such as `flagged-categories`), or null.
  # Test sends carry `{ "key" => "test", "value" => true }`.
  type event_fact_value = String | Integer | bool | Array[classification_category] | nil
                      | "moderation-status" | "automated-status" | "region" | "rule" | "status" | "reviewer-name" | "note"
                      | "child-asset" | "child-status" | "previous-status" | "failure-reason" | "completed-sections"
                      | "total-sections" | "batch-id" | "review-reason" | "uncertain-categories" | "review-id" | "decision"
                      | "applied-to-asset" | "hash-list-id" | "hash-list-name" | "distance" | "match-action" | "limit" | "used"
                      | "organisation-id" | "reason" | "resumes-at" | "preset-id" | "preset-name" | "daily-limit"
                      | "member-user-id" | "member-name" | "role" | "previous-role" | "invitee-email"
                      | "previous-organisation-id" | "previous-organisation-name" | "organisation-name" | "method"
                      | "api-keys-revoked" | "connectors-paused" | "key-id" | "key-name" | "created-by-name"
                      | "revoked-by-name" | "deleted-by-name" | "connector-id" | "connector-name" | "connector-type"
                      | "consecutive-failures" | "last-error"
  type event_fact_input = { key: String, value: event_fact_value, ?url: String }

  # Who caused an event: a `user` (a person in the portal, or an assistant acting for one), an
  # `api-key`, `automated` moderation or CalmLens itself (`system`). `id` is the user's or API key's
  # ID, nil for `automated` and `system` and when it was not recorded.
  type actor_type = "user" | "api-key" | "automated" | "system"
  type actor_input = { type: actor_type, id: String? }

  # ---- Method options -------------------------------------------------------------------------

  type viewer_claims = { ?region: String, ?age_confirmed: bool }

  # The resources beneath an asset URL ({CalmLens::CDN::RESOURCES}).
  type cdn_resource = "original" | "rendered" | "preview" | "hls" | "embed" | "placeholder" | "info"

  # Upload content: exactly one of `plain_text`, `base64` (optionally a data URL) or `data` (a
  # binary String or an IO, which streams). `size_in_bytes` is required for an IO of unknown length.
  type upload_content = { type: String, plain_text: String, ?size_in_bytes: Integer }
                      | { type: String, base64: String, ?size_in_bytes: Integer }
                      | { type: String, data: String | Transport::_Reader, ?size_in_bytes: Integer }
  # The first part of a multipart upload.
  type upload_first_part = { type: String, plain_text: String, ?is_final: bool, ?size_in_bytes: Integer }
                         | { type: String, base64: String, ?is_final: bool, ?size_in_bytes: Integer }
                         | { type: String, data: String | Transport::_Reader, ?is_final: bool, ?size_in_bytes: Integer }
  # A later part of a multipart upload; part numbers start at 2.
  type upload_part = { part_number: Integer, plain_text: String, ?is_final: bool, ?size_in_bytes: Integer }
                   | { part_number: Integer, base64: String, ?is_final: bool, ?size_in_bytes: Integer }
                   | { part_number: Integer, data: String | Transport::_Reader, ?is_final: bool, ?size_in_bytes: Integer }

  # Options of {UploadTokens#sign}.
  type sign_upload_token_options = {
    upload_preset_id: String,
    ?external_id: String,
    # Seconds the token can start an upload, 1 to 3600; 600 by default.
    ?expires_in: Integer,
    ?request_options: request_options
  }

  # Policy settings as options: snake_case Symbol keys, or a policy's `settings` as the API returned it.
  type policy_rule_input = { when: Array[moderation_qualifier], action: flagged_content_action, ?name: String, ?unless: Array[moderation_qualifier] }
  # Every category needs its `action`, `allowances` and `restrictions`.
  type category_policy_settings_input = {
    action: flagged_content_action,
    allowances: Array[policy_rule_input],
    restrictions: Array[policy_rule_input]
  }
  type link_safety_settings_input = {
    verdict_actions: Hash[String | Symbol, link_safety_action],
    ?off_platform_links: { action: "limit" | "age-restrict" | "block", allowed_domains: Array[String] }
  }
  type policy_settings_input = PolicySettings | {
    category_settings: {
      sexual: category_policy_settings_input,
      violence: category_policy_settings_input,
      :"self-harm" => category_policy_settings_input,
      harassment: category_policy_settings_input,
      hate: category_policy_settings_input,
      :"criminal-activity" => category_policy_settings_input,
      :"personal-information" => category_policy_settings_input,
      profanity: category_policy_settings_input
    },
    ?link_safety: link_safety_settings_input
  }

  # One preset's whole definition, by `key`; fields left out take their defaults. Send the `revision`
  # you read (0 for a preset that must not exist yet) to refuse a change made since.
  type upload_preset_definition = {
    key: String,
    name: String,
    ?revision: Integer,
    ?access: upload_preset_access,
    ?enabled: bool,
    ?allowed_content_types: Array[String]?,
    ?max_size_in_bytes: Integer?,
    ?folder_id: String?,
    ?policy_id: String?,
    ?visibility: asset_visibility,
    ?processing_options: processing_options_input?,
    ?reveal_decision: bool,
    ?daily_upload_limit: Integer?,
    ?allowed_origins: Array[String]?
  }
  # The complete settings: those left out return to their defaults.
  type project_settings_input = {
    ?opt_out_jurisdictions: Array[opt_out_jurisdiction],
    ?retain_content: bool,
    ?block_unmoderated_assets: bool,
    ?store_sensitive_metadata: bool,
    ?link_checking_enabled: bool,
    ?streaming_enabled: bool,
    ?ai_media_search_enabled: bool,
    ?remote_url_rule: { mode: "allow" | "deny", domains: Array[String] }?,
    ?website_submissions_per_minute: Integer?,
    ?human_review: {
      ?allowed_sample_percent: number,
      ?restricted_sample_percent: number,
      ?uncertainty_margin_percent: number,
      ?review_missing_evidence: bool
    }
  }
  type metadata_field_input = {
    id: String,
    title: String,
    ?description: String,
    type: metadata_field_type,
    icon: metadata_field_icon,
    color: String
  }

  # Options of {MockServerClient#enqueue_event}. Omitted fields are filled in.
  type mock_event_input = {
    type: event_type,
    ?id: String,
    ?project_id: String,
    # The mock API key (`{ 'type' => 'api-key', 'id' => nil }`) when omitted.
    ?actor: actor_input,
    ?severity: event_severity,
    ?title: String,
    ?description: String?,
    ?asset_id: String?,
    ?asset: {
      id: String,
      ?external_id: String?,
      upload: { status: "uploading" | "completed" },
      classification: { status: asset_classification_status, moderation: { decision: asset_moderation_decision? } },
      content: { status: asset_content_status }
    }?,
    ?facts: Array[event_fact_input],
    ?created_at: Integer
  }
end
