# Request and response shapes of the CalmLens API, mirroring the Zod schemas in packages/shared/src.
#
# Options (`*_options`, `*_input`) are the snake_case Symbol keys the SDK documents. At runtime the
# SDK also accepts camelCase and String keys, which these records do not describe.
#
# Responses keep the API's camelCase String keys. Fields marked optional (`?"key"`) can be missing
# from the JSON; `T?` values can be null. Records whose variants differ by `status` (category,
# qualifier and feature results) are one record with every variant's keys optional, because Steep
# cannot narrow a union of records on a key's value: read `status` first, then the keys it names.
module CalmLens
  # Any JSON value the API returns where it allows arbitrary JSON (metadata values, error details).
  type json_value = String | Integer | Float | bool | nil | Array[json_value] | Hash[String, json_value]
  # Any value the SDK can encode as JSON.
  type json_input = String | Integer | Float | bool | nil | Array[json_input] | Hash[String | Symbol, json_input]
  # A JSON number: whole numbers parse as Integer, others as Float.
  type number = Integer | Float

  # Per-call settings every method accepts under `request_options:`.
  type request_options = {
    ?idempotency_key: String,
    ?timeout: number,
    ?open_timeout: number,
    ?upload_timeout: number,
    ?max_retries: Integer,
    ?max_response_bytes: Integer
  }

  # ---- Assets (Asset.ts) ----------------------------------------------------------------------

  # Where the asset is in the pipeline: `queued` while it waits for its content (a multipart upload
  # still receiving parts) or its turn, `processing`, then `completed` or `failed`. The asset is
  # settled once it is `completed` or `failed`.
  type asset_classification_status = "queued" | "processing" | "completed" | "failed"
  # A moderation decision, which also decides delivery: served to anyone with access (`allowed`),
  # served like `allowed` but marked so your app reduces its reach (`limited`), only through signed
  # URLs or API keys (`age-restricted`), not served (`blocked`), or not served with the stored
  # content deleted (`purged`).
  type asset_moderation_decision = "allowed" | "limited" | "age-restricted" | "blocked" | "purged"
  # The decision in force: `pending` until classification decides, then a reviewer's decision when
  # there is one, else the policy's.
  type asset_moderation_status = "pending" | asset_moderation_decision
  # Whether CalmLens holds the content: only until processing finishes, retained, or deleted.
  type asset_content_status = "temporary" | "stored" | "removed"
  type asset_content_removal_reason = "policy" | "retention" | "requested" | "parent-removed" | "disposed"
  # Why processing failed, while the classification status is `failed`.
  type asset_classification_failure_reason = "file-too-large" | "duration-limit" | "resolution-limit" | "unsupported-format" | "undecodable-content" | "multiple-tracks" | "type-mismatch" | "free-uploads-exhausted" | "media-limit" | "uploads-paused" | "too-many-items" | "processing-error"
  type asset_type = "image" | "video" | "audio" | "plaintext-document" | "multimedia-document" | "website" | "file"
  type asset_visibility = "public" | "private"
  # FLAGGED_CONTENT_ACTION_SCHEMA in PolicyRule.ts.
  type flagged_content_action = "allow" | "limit" | "age-restrict" | "block" | "purge"

  # A custom metadata item. `value` is any JSON value you chose.
  type metadata_item = { "id" => String, "value" => json_value }
  # A metadata item to send. Keys inside `metadata` are sent unchanged, so use `id:` and `value:`.
  type metadata_item_input = { id: String, value: json_input }
  # An earlier post in the conversation, as the API returns it.
  type moderation_context_item = { "text" => String, ?"authorId" => String }
  # Earlier posts in the conversation, oldest first.
  type moderation_context = { "items" => Array[moderation_context_item] }
  # An earlier post to send. `author_id` is your identifier for who wrote it.
  type moderation_context_item_input = { text: String, ?author_id: String }
  # Earlier posts to send, oldest first; only the posts CalmLens uses are sent.
  type moderation_context_input = { items: Array[moderation_context_item_input] }

  # ProcessingFeatures.ts: optional analyses to run, keyed by feature. Link detection runs unless
  # `enabled` is false; every other feature is off unless `enabled` is true.
  type processing_features_input = {
    ?ocr: { enabled: bool }?,
    ?person_detection: { enabled: bool }?,
    ?face_detection: { enabled: bool, ?age_estimation: bool }?,
    ?link_detection: { enabled: bool }?,
    # Preview. Prepares an adaptive stream (HLS) of audio or video, served at the `hls` resource and
    # played by the `embed` resource; needs `retain_content`. Left out, the project's
    # streaming setting decides.
    ?streaming: { enabled: bool }?
  }
  type processing_options_input = {
    ?retain_content: bool?,
    # Overrides the project's `storeSensitiveMetadata` setting: false removes embedded EXIF, XMP and
    # IPTC metadata before the image is stored; true stores it as uploaded.
    ?store_sensitive_metadata: bool?,
    ?features: processing_features_input?
  }

  type checksums = {
    ?"md5" => String?,
    ?"sha1" => String?,
    ?"sha256" => String?,
    ?"sha384" => String?,
    ?"sha512" => String?
  }
  # One rendition of an adaptive stream: `video` for a picture size (video renditions carry no sound;
  # they play with the `audio` rendition), or `audio`. `bandwidth` is the peak bit rate in bits per
  # second, counting the audio a video rendition plays with; `codecs` are RFC 6381 names.
  type asset_hls_rendition = {
    "kind" => "video" | "audio",
    "width" => Integer?,
    "height" => Integer?,
    "bandwidth" => Integer,
    "codecs" => String
  }
  # Preview. The adaptive stream of audio or video: HLS with fragmented MP4 (CMAF) segments, served
  # at the CDN's `hls` resource (`hls/index.m3u8`) and played by its `embed` resource. Renditions list
  # video from the largest down, then audio.
  type asset_hls = {
    "status" => String,
    "reason" => String?,
    "renditions" => Array[asset_hls_rendition]
  }
  type asset_rendered_kind = "image" | "pdf" | "video" | "audio"
  # The asset's one displayable file, as the CDN's `rendered` resource serves it: an image, a PDF, or
  # browser-safe video or audio. `peaks` is an audio waveform's normalised peaks.
  type asset_rendered = {
    "kind" => asset_rendered_kind,
    "format" => String,
    "width" => Integer?,
    "height" => Integer?,
    ?"peaks" => Array[Float]
  }
  # The still image that stands for the asset, as the CDN's `preview` resource serves it; the
  # `placeholder` resource is its ThumbHash as a small blurred PNG.
  type asset_preview = {
    "width" => Integer?,
    "height" => Integer?,
    "thumbhash" => String?,
    "averageColor" => String?
  }
  type safety_hold = { "placedAt" => Integer, "reason" => "suspected-illegal-content", ?"disposedAt" => Integer? }
  # `type: "string"` carries the text in `content`; `type: "document"` stores it under `id`.
  type extracted_text = { "type" => "string" | "document", ?"content" => String, ?"id" => String }
  # Descriptive metadata embedded in an uploaded file. `capturedAt` is ISO 8601, with a UTC offset
  # only when the file records one. `digitalSourceType` is the IPTC code the file declares, such as
  # `digitalCapture`. `containsLocation` says whether the uploaded file embedded GPS coordinates;
  # `creator` and `location` are sensitive and recorded only when `storeSensitiveMetadata` is on.
  type file_metadata_location = { "latitude" => number, "longitude" => number }
  type file_metadata = {
    "capturedAt" => String?,
    "cameraMake" => String?,
    "cameraModel" => String?,
    "lensModel" => String?,
    "software" => String?,
    "creator" => String?,
    "copyright" => String?,
    "digitalSourceType" => String?,
    "containsLocation" => bool,
    "location" => file_metadata_location?
  }

  type asset_upload = { "status" => "uploading" | "completed", "updatedAt" => Integer?, "partsReceived" => Integer? }
  # How many sections of long audio or video are analysed so far.
  type classification_progress = { "completedSections" => Integer, "totalSections" => Integer }
  type asset_classification = {
    "status" => asset_classification_status,
    # `null` unless `status` is `failed`.
    "failureReason" => asset_classification_failure_reason?,
    "updatedAt" => Integer?,
    "completedAt" => Integer?,
    # While long audio or video is analysed in sections and `status` is `processing`: how many of its
    # sections are done. `nil` otherwise.
    "progress" => classification_progress?,
    # Whether the results came from one of the project's test inputs rather than analysing the
    # content. Never use test results, such as age ranges, for real decisions.
    "testInput" => bool,
    "moderation" => asset_moderation,
    # OCR's result for an image processed with OCR turned on; `nil` when OCR didn't run.
    "ocr" => ocr_result?,
    # Link detection's result for an image; `nil` when it didn't run.
    "linkDetection" => link_detection_result?,
    # Preview. Person and face detection's results; `nil` when they didn't run.
    ?"personDetection" => person_detection_result?,
    ?"faceDetection" => face_detection_result?,
    # Preview. Where the asset's links lead when the project's policy acts on links; otherwise `nil`.
    ?"linkSafety" => link_safety_result?,
    ?"aiGeneratedDetection" => ai_generated_detection_result?
  }
  # Who made a review: a person (`user`, also when an assistant's key acts for one) or an API key
  # (`api-key`), with the user's or API key's ID, `nil` only when it was not recorded.
  type review_actor = { "type" => "user" | "api-key", "id" => String? }
  type asset_review = {
    "id" => String,
    "decision" => asset_moderation_decision,
    "note" => String?,
    "decidedBy" => review_actor,
    "reviewedAt" => Integer,
    # Whether the decision was applied to the asset; `false` for a review queue decision recorded
    # without changing the asset's status.
    "applied" => bool
  }
  # A stricter delivery decision in one region the project serves: the status in force there, the
  # mandatory rule that sets it and the category whose findings it acted on, when it acts on one.
  type regional_decision = {
    "region" => String,
    "status" => "limited" | "age-restricted" | "blocked" | "purged",
    "rule" => String,
    ?"category" => String
  }
  # What decided the automated status: the `policy`'s categories, the asset's `children`, a
  # `hash-list` match, a `mandatory-rule` or `link-safety`.
  type moderation_source = "policy" | "children" | "hash-list" | "mandatory-rule" | "link-safety"
  # The policy that made a decision: its ID, its revision then and, for a policy from a preset, the
  # preset release it used.
  type decision_policy = {
    "id" => String,
    "revision" => Integer,
    "preset" => { "id" => String, "version" => Integer }?
  }
  # A review the human review queue is waiting for: when the asset joined it (Unix milliseconds),
  # why, and the categories that made the decision uncertain.
  type asset_pending_review = {
    "requestedAt" => Integer,
    "reason" => "sampled" | "uncertain",
    "uncertainCategories" => Array[String]
  }
  # Every field but `status`, `manualReviews`, `flaggedCategories`, `regions` and `timeline` is `nil`
  # until moderation decides; `pendingReview` is `nil` when no review is waiting.
  type asset_moderation = {
    "manualReviews" => Array[asset_review],
    "status" => asset_moderation_status,
    # The policy's original decision; a reviewer's decision can change `status` without changing it.
    "automatedStatus" => asset_moderation_decision?,
    # The policy that made the automated decision, as it was then.
    "policy" => decision_policy?,
    # The review the human review queue is waiting for, set with the automated decision that
    # joined the queue; `nil` when no review is waiting.
    "pendingReview" => asset_pending_review?,
    "source" => moderation_source?,
    # The mandatory rule that decided, when `source` is `mandatory-rule`; otherwise `nil`.
    "rule" => String?,
    "flaggedCategories" => Array[String], "regions" => Array[regional_decision],
    "explanationComplete" => bool?,
    "categories" => Hash[String, category_policy_score]?,
    # Preview. What the policy's link-safety section made of the asset's links; `nil` when the
    # policy doesn't act on links.
    ?"linkSafety" => link_safety_decision?,
    # An audio or video asset's findings timeline: how many segments `assets.list_timeline` lists.
    # `null` for other assets and media without findings.
    "timeline" => moderation_timeline?,
    "raw" => moderation_raw?
  }
  # ASSET_CONTENT_SCHEMA. `format` is the MIME type.
  type asset_content = {
    "status" => asset_content_status,
    "removalReason" => asset_content_removal_reason?,
    "updatedAt" => Integer?,
    "safetyHold" => safety_hold?,
    "format" => String?,
    "extension" => String?,
    "sizeInBytes" => Integer?,
    "checksums" => checksums?,
    # The file's own size, length and page count, where they apply; `null` when unknown.
    "width" => Integer?,
    "height" => Integer?,
    "durationSeconds" => Float?,
    "pageCount" => Integer?,
    "perceptualHash" => String?,
    # How much detail `perceptualHash` captured, from 0 to 100; hashes below 50 match unrelated pictures.
    "perceptualHashQuality" => Integer?,
    # Metadata embedded in the uploaded file; `null` when it declares none, once the content is
    # removed and while the asset is held.
    "metadata" => file_metadata?,
    "extractedText" => extracted_text?,
    # `null` until processing makes it, for text, spreadsheets and other files, once the content is
    # removed and while the asset is held.
    "rendered" => asset_rendered?,
    # Preview. The adaptive stream once streaming has prepared one for audio or video; `nil` for
    # other assets, until then, once the content is removed and while the asset is held.
    "hls" => asset_hls?,
    "preview" => asset_preview?
  }

  type asset = {
    "id" => String,
    "projectId" => String,
    ?"parentId" => String?,
    # The pages of the parent document a child shows, from 1; empty when unknown or not a child.
    ?"parentPages" => Array[Integer],
    ?"folderId" => String?,
    ?"uploadPresetId" => String?,
    "createdAt" => Integer,
    ?"updatedAt" => Integer,
    "name" => String,
    ?"description" => String?,
    ?"externalId" => String?,
    ?"externalUrl" => String?,
    "type" => asset_type,
    # Empty when the asset has none.
    "metadata" => Array[metadata_item],
    ?"authorId" => String?,
    # The earlier posts CalmLens used; null once the content is removed.
    ?"context" => moderation_context?,
    # Empty when the asset has none.
    "tags" => Array[String],
    "visibility" => asset_visibility,
    "upload" => asset_upload,
    "classification" => asset_classification,
    "content" => asset_content
  }

  # ---- Moderation report (Classification.ts, ProcessingFeatures.ts) ----------------------------

  type likelihood = "very-unlikely" | "unlikely" | "possible" | "likely" | "very-likely"
  # not-supported: this processing path cannot assess the signal; unavailable: assessment failed.
  type not_evaluated_reason = "not-supported" | "unavailable"
  # A processing feature's reason, which adds in-children: a document's or website's images are each
  # a child asset with its own result (`assets.list_children`).
  type feature_not_evaluated_reason = not_evaluated_reason | "in-children"
  type classification_category = "sexual" | "violence" | "self-harm" | "harassment" | "hate" | "criminal-activity"

  # `status: "evaluated"` carries `someScore`, `likelihood` and optionally `allScore`;
  # `status: "not-evaluated"` carries `reason`.
  type qualifier_result = {
    "status" => "evaluated" | "not-evaluated",
    ?"someScore" => number,
    ?"allScore" => number,
    ?"likelihood" => likelihood,
    ?"reason" => not_evaluated_reason
  }
  # qualifier_results is generated in qualifiers.rbs.

  # `status: "evaluated"` or `"partial"` carries `likelihood` and `score`; `"not-evaluated"`
  # carries `reason`.
  type category_report = {
    "status" => "evaluated" | "partial" | "not-evaluated",
    ?"likelihood" => likelihood,
    ?"score" => number,
    ?"reason" => not_evaluated_reason,
    ?"qualifiers" => qualifier_results
  }
  type classification_categories = {
    "sexual" => category_report,
    "violence" => category_report,
    "self-harm" => category_report,
    "harassment" => category_report,
    "hate" => category_report,
    "criminal-activity" => category_report,
    "personal-information" => category_report,
    "profanity" => category_report
  }
  type media_segment = {
    "source" => "frame" | "speech" | "frame-text" | "clip",
    "startSeconds" => number,
    "endSeconds" => number,
    "categories" => classification_categories
  }

  # Position and size as fractions of the image width and height, from 0 to 1.
  type bounding_box = { "left" => number, "top" => number, "width" => number, "height" => number }
  type age_range = { "low" => Integer, "high" => Integer }
  type detected_person = { "box" => bounding_box, "confidence" => number }
  type detected_face = { "box" => bounding_box, "confidence" => number, ?"ageRange" => age_range }
  # `status: "evaluated"` carries `people`; `"not-evaluated"` carries `reason`.
  type person_detection_result = {
    "status" => "evaluated" | "not-evaluated",
    ?"people" => Array[detected_person],
    ?"reason" => feature_not_evaluated_reason
  }
  # `status: "evaluated"` carries `faces`; `"not-evaluated"` carries `reason`.
  type face_detection_result = {
    "status" => "evaluated" | "not-evaluated",
    ?"faces" => Array[detected_face],
    ?"reason" => feature_not_evaluated_reason
  }
  type detected_qr_code = { "value" => String, "box" => bounding_box }
  # A web link found in a QR code or in the text OCR extracted.
  type detected_link = { "url" => String, "source" => "qr-code" | "text" }
  # `status: "evaluated"` carries `qrCodes` and `links`; `"not-evaluated"` carries `reason`.
  type link_detection_result = {
    "status" => "evaluated" | "not-evaluated",
    ?"qrCodes" => Array[detected_qr_code],
    ?"links" => Array[detected_link],
    ?"reason" => feature_not_evaluated_reason
  }
  # Link safety (preview, LinkSafety.ts).
  # What a link's destination is: `safe` when every reputation check passed, `adult` or `gambling`
  # from its domain's content categories, `phishing` or `malware` from a threat list or the domain's
  # security risks, and `unresolved` when a short link or redirect chain could not be followed or a
  # check failed. Every address on a link's way is checked, and the most severe verdict is the
  # link's.
  type link_safety_verdict = "safe" | "adult" | "gambling" | "phishing" | "malware" | "unresolved"
  # The verdicts a policy can act on.
  type flagged_link_verdict = "phishing" | "malware" | "adult" | "gambling" | "unresolved"
  # What a link does to its asset, weakest first. Purging content over a link is never offered.
  type link_safety_action = "allow" | "limit" | "age-restrict" | "block"
  # One reputation check of a link, every address it redirects through and its destination: their
  # domain categories, or a threat-list lookup of their URLs. `failed` makes the link `unresolved`;
  # `labels` is what the check reported for any of the addresses.
  type link_safety_evidence = {
    "check" => "domain-categories" | "threat-lists",
    "status" => "checked" | "failed",
    "labels" => Array[String]
  }
  # A link in the asset and what its destination is. `finalUrl` is where it leads after `redirects`
  # redirects, or `null` when a short link or redirect chain could not be
  # followed.
  type checked_link = {
    "url" => String,
    "finalUrl" => String?,
    "redirects" => Integer,
    "source" => "qr-code" | "text",
    "verdict" => link_safety_verdict,
    "evidence" => Array[link_safety_evidence]
  }
  # Preview. `status: "evaluated"` carries `links`; `"not-evaluated"` carries `reason`.
  type link_safety_result = {
    "status" => "evaluated" | "not-evaluated",
    ?"links" => Array[checked_link],
    ?"reason" => not_evaluated_reason
  }
  # Preview. LINK_SAFETY_SETTINGS_SCHEMA: the action for an asset with a link of each verdict (a
  # verdict left out is allowed), and optionally an action for every link whose destination is
  # outside `allowedDomains` (bare lowercase domains, which also cover their subdomains).
  type link_safety_settings = {
    "verdictActions" => {
      ?"phishing" => link_safety_action,
      ?"malware" => link_safety_action,
      ?"adult" => link_safety_action,
      ?"gambling" => link_safety_action,
      ?"unresolved" => link_safety_action
    },
    ?"offPlatformLinks" => { "action" => "limit" | "age-restrict" | "block", "allowedDomains" => Array[String] }
  }
  # Preview. The strongest action the asset's links take, the checked links that take it, and the
  # settings in force.
  type link_safety_decision = {
    "action" => link_safety_action,
    "links" => Array[checked_link],
    "settings" => link_safety_settings
  }
  type provenance_signal = { "kind" => "c2pa" | "iptc-digital-source-type" | "generator-metadata", "value" => String }
  # `status: "evaluated"` carries `provenance` and `signals`; `"not-evaluated"` carries `reason`.
  type ai_generated_detection_result = {
    "status" => "evaluated" | "not-evaluated",
    ?"provenance" => "ai-generated" | "ai-edited" | "unknown",
    ?"signals" => Array[provenance_signal],
    ?"reason" => feature_not_evaluated_reason
  }
  # Where OCR found text in an image, and whether it is personal information.
  type text_region = { "box" => bounding_box, "personalInformation" => bool }
  # `status: "evaluated"` carries `textRegions`, where OCR found text; `"not-evaluated"` carries `reason`. The text itself is `content.extractedText`.
  type ocr_result = {
    "status" => "evaluated" | "not-evaluated",
    ?"textRegions" => Array[text_region],
    ?"reason" => feature_not_evaluated_reason
  }

  # How strongly each assessed category meets the policy and what the policy does with it.
  type policy_rule_snapshot = {
    "when" => Array[String], "action" => flagged_content_action,
    ?"name" => String, ?"unless" => Array[String]
  }
  # What decided a category's action: its `default` action, a policy score `below-threshold`, or the
  # `allowance` or `restriction` rules listed by `indexes` (at least one, the decisive rule first).
  type category_policy_source = { "kind" => "default" | "below-threshold" } |
                                { "kind" => "allowance" | "restriction", "indexes" => Array[Integer], "conditionScore" => Float }
  type category_policy_settings_snapshot = {
    "action" => flagged_content_action,
    "allowances" => Array[policy_rule_snapshot], "restrictions" => Array[policy_rule_snapshot]
  }
  type category_policy_score = {
    "score" => number, "action" => flagged_content_action,
    ?"source" => category_policy_source, ?"settings" => category_policy_settings_snapshot
  }
  type moderation_timeline = { "segmentCount" => Integer }
  type moderation_raw = {
    "categories" => classification_categories,
    # Empty when the image matched no hash list entry.
    "hashMatches" => Array[hash_match]
  }

  # ---- Pages and search (Page.ts, AssetSearch.ts) --------------------------------------------

  # A list's sort: comma-separated fields, each ascending unless prefixed with `-`, such as
  # `-createdAt,id`.
  type sort = String

  type asset_page = {
    "items" => Array[asset],
    "hasMore" => bool,
    "nextCursor" => String?
  }
  # One page of an audio or video asset's findings timeline, in time order.
  type asset_timeline_page = {
    "items" => Array[media_segment],
    "hasMore" => bool,
    "nextCursor" => String?
  }

  type asset_search_mode = "keyword" | "semantic" | "hybrid"
  type asset_search_match_field = "name" | "id" | "externalId" | "description" | "tags" | "type" | "content.format" |
                                  "content.extension" | "classification.moderation.status" | "visual" | "transcript"
  type asset_search_result = { "asset" => asset, "score" => number, "matchedFields" => Array[asset_search_match_field] }
  type asset_search_response = {
    "query" => String,
    "items" => Array[asset_search_result],
    "semanticStatus" => "disabled" | "ready" | "indexing" | "unavailable"
  }

  type asset_batch_operation = "delete" | "remove-content"
  # `batchId` is named by the `batch-id` fact of the events the batch causes.
  type batch_assets_response = { "batchId" => String, "status" => "queued", "assetCount" => Integer }
  # A signed asset URL, with any resource, selector and viewer claims appended, and when it expires
  # (milliseconds since the Unix epoch).
  type signed_asset_url = { "url" => String, "expiresAt" => Integer }
  # Whether the viewer an asset URL's claims describe can see the content now.
  type asset_availability = "available" | "age-restricted" | "unavailable"
  # ASSET_INFO_SCHEMA: what the CDN's `info` resource returns, an allowlist of the asset's public
  # fields plus the viewer's `availability`.
  type asset_info = {
    "id" => String,
    "projectId" => String,
    "type" => asset_type,
    "externalUrl" => String?,
    "content" => {
      "format" => String?,
      "width" => Integer?,
      "height" => Integer?,
      "durationSeconds" => Float?,
      "pageCount" => Integer?,
      "rendered" => asset_rendered?,
      "preview" => asset_preview?,
      "hls" => asset_hls?
    },
    "availability" => asset_availability
  }

  # ---- Transforms and lenses (AssetTransform.ts, Lens.ts) -------------------------------------

  # <generated: image-transform-options>
  # Generated by packages/sdk-contract/generate.ts from IMAGE_TRANSFORM_OPTIONS_SCHEMA; do not edit.
  type image_format = "jpg" | "png" | "webp" | "avif" | "gif"
  type image_quality_level = "low" | "medium" | "high"
  type image_fit = "scale-down" | "contain" | "pad" | "squeeze" | "cover" | "crop"
  type image_flip = "h" | "v" | "hv"
  type image_segment = "foreground"
  type image_gravity_side = "face" | "left" | "right" | "top" | "bottom" | "center" | "auto" | "entropy"
  type image_gravity_mode = "remainder" | "box-center"

  # IMAGE_TRANSFORM_OPTIONS_SCHEMA, as options to send.
  type image_transform_options_input = {
    ?format: image_format,
    ?width: Integer,
    ?height: Integer,
    ?dpr: number,
    ?anim: bool,
    ?background: String,
    ?blur: number,
    ?border: {
      ?color: String,
      ?width: number
    },
    ?brightness: number,
    ?contrast: number,
    ?quality: Integer | image_quality_level,
    ?fit: image_fit,
    ?flip: image_flip,
    ?gamma: number,
    ?segment: image_segment,
    ?gravity: image_gravity_side | {
      mode: image_gravity_mode,
      ?x: number,
      ?y: number
    },
    ?rotate: 0 | 90 | 180 | 270,
    ?saturation: number,
    ?sharpen: number,
    ?trim: "border" | {
      ?top: number,
      ?bottom: number,
      ?left: number,
      ?right: number,
      ?width: number,
      ?height: number,
      ?border: bool | {
        ?color: String,
        ?tolerance: number,
        ?keep: number
      }
    }
  }
  # IMAGE_TRANSFORM_OPTIONS_SCHEMA, as the API returns it in a lens.
  type image_transform_options = {
    ?"format" => image_format,
    ?"width" => Integer,
    ?"height" => Integer,
    ?"dpr" => number,
    ?"anim" => bool,
    ?"background" => String,
    ?"blur" => number,
    ?"border" => {
      ?"color" => String,
      ?"width" => number
    },
    ?"brightness" => number,
    ?"contrast" => number,
    ?"quality" => Integer | image_quality_level,
    ?"fit" => image_fit,
    ?"flip" => image_flip,
    ?"gamma" => number,
    ?"segment" => image_segment,
    ?"gravity" => image_gravity_side | {
      "mode" => image_gravity_mode,
      ?"x" => number,
      ?"y" => number
    },
    ?"rotate" => 0 | 90 | 180 | 270,
    ?"saturation" => number,
    ?"sharpen" => number,
    ?"trim" => "border" | {
      ?"top" => number,
      ?"bottom" => number,
      ?"left" => number,
      ?"right" => number,
      ?"width" => number,
      ?"height" => number,
      ?"border" => bool | {
        ?"color" => String,
        ?"tolerance" => number,
        ?"keep" => number
      }
    }
  }
  # </generated: image-transform-options>

  # Transform options applied in one pass: a selector String such as `width=1024,fit=cover`, or
  # structured options, which the SDK serializes into a selector.
  type transform_input = String | image_transform_options_input

  type lens_type = "image" | "video" | "audio" | "document" | "website"
  # ENSURE_LENS_BODY_SCHEMA: a lens definition, which the CDN serves once it is saved unless `active` is false.
  type lens_definition = {
    identifier: String,
    name: String,
    type: lens_type,
    ?active: bool,
    ?description: String?,
    ?transform: image_transform_options_input?
  }
  type lens = {
    "id" => String,
    ?"projectId" => String?,
    "identifier" => String,
    "name" => String,
    ?"description" => String?,
    "type" => lens_type,
    "active" => bool,
    ?"transform" => image_transform_options?,
    "createdAt" => Integer,
    ?"updatedAt" => Integer
  }
  type lens_page = {
    "items" => Array[lens],
    "hasMore" => bool,
    "nextCursor" => String?
  }

  # ---- Configuration as data (UploadPreset.ts, ProjectConfiguration.ts) --------------------------

  type upload_preset_access = "token" | "anyone"
  # An upload preset's processing options, as the API returns them.
  type upload_preset_processing_options = {
    ?"retainContent" => bool?,
    ?"storeSensitiveMetadata" => bool?,
    ?"features" => {
      ?"ocr" => { "enabled" => bool }?,
      ?"personDetection" => { "enabled" => bool }?,
      ?"faceDetection" => { "enabled" => bool, ?"ageEstimation" => bool? }?,
      ?"linkDetection" => { "enabled" => bool }?,
      ?"streaming" => { "enabled" => bool }?
    }?
  }
  # The rules for uploads made from browsers and apps. `key` is unique in its project; `revision`
  # counts changes, starting at 1. Send it back with a change.
  type upload_preset = {
    "id" => String,
    "projectId" => String,
    ?"createdByUserId" => String?,
    "key" => String,
    "revision" => Integer,
    "name" => String,
    "access" => upload_preset_access,
    "enabled" => bool,
    ?"allowedContentTypes" => Array[String]?,
    ?"maxSizeInBytes" => Integer?,
    ?"folderId" => String?,
    ?"policyId" => String?,
    "visibility" => asset_visibility,
    ?"processingOptions" => upload_preset_processing_options?,
    "revealDecision" => bool,
    ?"dailyUploadLimit" => Integer?,
    ?"allowedOrigins" => Array[String]?,
    "createdAt" => Integer,
    "updatedAt" => Integer
  }
  type upload_preset_page = { "items" => Array[upload_preset], "hasMore" => bool, "nextCursor" => String? }
  type ensure_upload_presets_response = { "uploadPresets" => Array[upload_preset] }

  type remote_url_rule = { "mode" => "allow" | "deny", "domains" => Array[String] }
  type human_review_settings = {
    "allowedSamplePercent" => number,
    "restrictedSamplePercent" => number,
    "uncertaintyMarginPercent" => number,
    "reviewMissingEvidence" => bool
  }
  type public_project_settings = {
    "optOutJurisdictions" => Array[String],
    "retainContent" => bool,
    "blockUnmoderatedAssets" => bool,
    "storeSensitiveMetadata" => bool,
    "streamingEnabled" => bool,
    "aiMediaSearchEnabled" => bool,
    "remoteUrlRule" => remote_url_rule?,
    "websiteSubmissionsPerMinute" => Integer?,
    "humanReview" => human_review_settings
  }
  # The project's settings, with defaults filled in. `revision` counts changes to the settings and
  # metadata fields, starting at 1. Send it back with a change.
  type project_settings_resource = { "projectId" => String, "revision" => Integer, "settings" => public_project_settings }

  type metadata_field_type = "string" | "number" | "boolean" | "date" | "url"
  type metadata_field_icon = "tag" | "hash" | "user" | "folder" | "layers" | "photo" | "link"
  # A metadata field the portal shows and filters by. `color` is `#rrggbb`.
  type metadata_field = {
    "id" => String,
    "title" => String,
    ?"description" => String,
    "type" => metadata_field_type,
    "icon" => metadata_field_icon,
    "color" => String
  }
  type metadata_fields_resource = { "projectId" => String, "revision" => Integer, "fields" => Array[metadata_field] }

  # ---- Folders (Folder.ts) --------------------------------------------------------------------

  type folder = {
    "id" => String,
    "projectId" => String,
    ?"parentId" => String?,
    "name" => String,
    "createdAt" => Integer,
    ?"updatedAt" => Integer
  }

  # ---- Hash lists (HashList.ts) ----------------------------------------------------------------

  type hash_list_action = "flag" | "block"

  type hash_list = {
    "id" => String,
    "projectId" => String,
    "name" => String,
    ?"description" => String?,
    "action" => hash_list_action,
    "createdAt" => Integer,
    ?"updatedAt" => Integer
  }

  # A hash list entry an image matched. `distance` is the number of differing bits (0 is the same
  # picture); `action` is `block` when the match was close enough for a block list to block.
  type hash_match = {
    "source" => "hash-list",
    "hashListId" => String,
    "hashListEntryId" => String,
    "distance" => Integer,
    "action" => hash_list_action
  }

  type hash_list_entry = {
    "id" => String,
    "projectId" => String,
    "hashListId" => String,
    "hash" => String,
    "quality" => number?,
    ?"label" => String?,
    # The asset the hash was taken from, when the entry was added from an asset.
    ?"assetId" => String?,
    "createdAt" => Integer
  }

  type hash_list_entry_page = {
    "items" => Array[hash_list_entry],
    "hasMore" => bool,
    "nextCursor" => String?
  }

  # ---- Policies (Policy.ts) ---------------------------------------------------------------------

  type policy_preset_id = "general-community" | "children-platform" | "education-support" | "wholesome-community"
  # What a policy does with one category: `action` when its policy score reaches 0.5, allowances
  # that let covered content through or act on it more softly, and restrictions, which outweigh
  # allowances.
  type category_policy_settings = {
    "action" => flagged_content_action,
    "allowances" => Array[policy_rule_snapshot],
    "restrictions" => Array[policy_rule_snapshot]
  }
  # Settings for every category, and optionally link safety.
  type policy_settings = {
    "categorySettings" => {
      "sexual" => category_policy_settings,
      "violence" => category_policy_settings,
      "self-harm" => category_policy_settings,
      "harassment" => category_policy_settings,
      "hate" => category_policy_settings,
      "criminal-activity" => category_policy_settings,
      "personal-information" => category_policy_settings,
      "profanity" => category_policy_settings
    },
    ?"linkSafety" => link_safety_settings
  }
  # How a policy relates to its preset: `live` follows the latest release (the organisation's own
  # preset policy with automatic updates on), `pinned` is the organisation's own preset policy held
  # at one release, and `copy` is a policy made from a preset.
  type policy_preset_mode = "live" | "pinned" | "copy"
  # Where a policy started from a built-in preset. `version` is the release it is pinned to,
  # `latestVersion` the newest.
  type policy_preset_origin = {
    "id" => policy_preset_id,
    "version" => Integer,
    "latestVersion" => Integer,
    "mode" => policy_preset_mode
  }
  # A moderation policy. Policies belong to the organisation and its projects share them. Send
  # `revision` with each change; a policy changed since is refused with `policy/revision-conflict`.
  type policy = {
    "id" => String,
    "name" => String,
    "description" => String,
    "settings" => policy_settings,
    "revision" => Integer,
    "preset" => policy_preset_origin?,
    "projectIds" => Array[String],
    "createdAt" => Integer,
    "updatedAt" => Integer
  }
  # A page of the organisation's policies, oldest first unless `sort` says otherwise.
  type policy_page = { "items" => Array[policy], "hasMore" => bool, "nextCursor" => String? }

  # ---- Events and webhooks (Event.ts, EventCatalog.ts, WebhookPayload.ts) ----------------------

  # EVENT_TYPES in EventCatalog.ts. Ignore types your code does not handle. Webhook, Slack and email
  # deliveries and the public events feed leave out facts that hold personal or account data.
  type event_type = "asset.uploaded" | "asset.classified" | "asset.region-restricted" | "asset.allowed" | "asset.limited" |
                    "asset.age-restricted" | "asset.blocked" | "asset.purged" | "asset.failed" | "asset.progress-updated" |
                    "asset.deleted" | "asset.content-removed" | "asset.retried" | "asset.rerun-requested" | "asset.review-requested" |
                    "asset.hash-matched" | "asset.link-flagged" | "usage.free-uploads-exhausted" | "usage.uploads-paused" |
                    "upload-preset.daily-limit-reached" | "project.member-joined" | "project.member-removed" |
                    "project.member-left" | "project.member-role-changed" | "project.invitation-sent" |
                    "project.transferred" | "api-key.created" | "api-key.revoked" | "api-key.deleted" |
                    "connector.disabled" | "appeal.submitted" | "appeal.resolved"
  type event_severity = "low" | "high"
  # A registered fact's value: text, an enum value, a count or a time in milliseconds (such as
  # `resumes-at`), a list of enum values (such as `flagged-categories`), or null.
  # Test sends carry `{ "key" => "test", "value" => true }`.
  type event_fact_value = String | Integer | bool | Array[String] | nil
  # A registered fact. `key` is a kebab-case key registered for the event's type, such as
  # `asset-name` or `flagged-categories`. Render `url` only when it is an internal path or HTTP(S) URL.
  type event_fact = { "key" => String, "value" => event_fact_value, ?"url" => String }
  type event_fact_input = { key: String, value: event_fact_value, ?url: String }

  # Snapshot of the asset's processing, moderation and content status when the event was created.
  type event_asset = {
    "id" => String,
    ?"uploadPresetId" => String?,
    ?"externalId" => String?,
    "upload" => { "status" => "uploading" | "completed" },
    # `testInput`: whether the results came from one of the project's test inputs rather than
    # analysing the content. Never use test results, such as age ranges, for real decisions.
    "classification" => { "status" => asset_classification_status, "testInput" => bool,
                          "moderation" => { "status" => asset_moderation_status } },
    "content" => { "status" => asset_content_status }
  }
  # Who caused an event: a `user` (a person in the portal, or an assistant acting for one), an
  # `api-key`, `automated` moderation or CalmLens itself (`system`). `id` is the user's or API key's
  # ID, nil for `automated` and `system` and when it was not recorded.
  type actor_type = "user" | "api-key" | "automated" | "system"
  type actor = { "type" => actor_type, "id" => String? }
  type actor_input = { type: actor_type, id: String? }

  # An `events.list` item, and the body of its webhook delivery.
  type event = {
    "id" => String,
    "projectId" => String,
    "actor" => actor,
    "type" => event_type,
    "severity" => event_severity,
    "title" => String,
    "description" => String?,
    "assetId" => String?,
    # Increases with each event about the same asset; nil for events not about an asset.
    "assetSequence" => Integer?,
    "asset" => event_asset?,
    "facts" => Array[event_fact],
    "createdAt" => Integer
  }
  # Unlike other lists, `nextCursor` is never nil: keep it to receive later events.
  # `excludedTypes` are the event types the feed never includes, because the API key lacks the permission
  # to see them.
  type events_page = {
    "items" => Array[event],
    "nextCursor" => String,
    "hasMore" => bool,
    "excludedTypes" => Array[event_type]
  }

  # ---- Method options -------------------------------------------------------------------------

  type viewer_claims = { ?region: String, ?age_confirmed: bool }
  type asset_id_options = { asset_id: String, ?request_options: request_options }
  # `timeout` is the whole wait in seconds (default 60).
  type wait_for_decision_options = { asset_id: String, ?timeout: number, ?request_options: request_options }

  type asset_search_options = {
    query: String,
    ?mode: asset_search_mode,
    # How many results, 1 to 20 (default 10).
    ?page_size: Integer,
    ?request_options: request_options
  }
  type list_assets_options = {
    ?cursor: String,
    ?page_size: Integer,
    # `createdAt` and `id`; `-createdAt` by default.
    ?sort: sort,
    # An RSQL filter such as `classification.moderation.status==allowed`; `folderId==fldr_…` lists
    # one folder's assets.
    ?filter: String?,
    ?request_options: request_options
  }
  type list_asset_children_options = {
    asset_id: String,
    ?cursor: String,
    ?page_size: Integer,
    ?sort: sort,
    ?request_options: request_options
  }
  type list_asset_timeline_options = {
    asset_id: String,
    ?cursor: String,
    ?page_size: Integer,
    ?request_options: request_options
  }
  type update_asset_options = {
    asset_id: String,
    ?name: String,
    ?description: String?,
    ?external_id: String?,
    ?external_url: String?,
    ?metadata: Array[metadata_item_input]?,
    ?tags: Array[String]?,
    ?visibility: asset_visibility?,
    ?request_options: request_options
  }
  type batch_assets_options = { asset_ids: Array[String], operation: asset_batch_operation, ?request_options: request_options }
  type move_asset_options = { asset_id: String, folder_id: String?, ?request_options: request_options }
  type explain_asset_options = { asset_id: String, ?rerun: bool, ?request_options: request_options }
  # A reviewer's decision. `note` is 1 to 1499 characters; purging also needs `confirm_purge: true`.
  type decide_asset_options = {
    asset_id: String,
    decision: "allowed" | "limited" | "age-restricted" | "blocked" | "purged",
    note: String,
    ?confirm_purge: bool,
    ?request_options: request_options
  }
  # The resources beneath an asset URL ({CalmLens::CDN::RESOURCES}).
  type cdn_resource = "original" | "rendered" | "preview" | "hls" | "embed" | "placeholder" | "info"
  type sign_asset_url_options = {
    # Exactly one of `asset_id` and `external_id`.
    ?asset_id: String,
    ?external_id: String,
    ?project_id: String,
    # Whole seconds from 1 to 86400; 900 by default.
    ?expires_in: Integer,
    # Whether the URL also serves `original`; false by default.
    ?original: bool,
    ?resource: cdn_resource,
    ?lens: String,
    ?transform: transform_input,
    ?viewer_claims: viewer_claims,
    ?request_options: request_options
  }

  # Upload content: exactly one of `plain_text`, `base64` (optionally a data URL) or `data` (a
  # binary String or an IO, which streams). `size_in_bytes` is required for an IO of unknown length.
  type upload_content = { type: String, plain_text: String, ?size_in_bytes: Integer }
                      | { type: String, base64: String, ?size_in_bytes: Integer }
                      | { type: String, data: String | Transport::_Reader, ?size_in_bytes: Integer }
  # The first part of a multipart upload.
  type upload_first_part = { type: String, plain_text: String, ?is_final: bool, ?size_in_bytes: Integer }
                         | { type: String, base64: String, ?is_final: bool, ?size_in_bytes: Integer }
                         | { type: String, data: String | Transport::_Reader, ?is_final: bool, ?size_in_bytes: Integer }
  # A later part of a multipart upload; part numbers start at 2.
  type upload_part = { part_number: Integer, plain_text: String, ?is_final: bool, ?size_in_bytes: Integer }
                   | { part_number: Integer, base64: String, ?is_final: bool, ?size_in_bytes: Integer }
                   | { part_number: Integer, data: String | Transport::_Reader, ?is_final: bool, ?size_in_bytes: Integer }

  # Options of {Assets#create} and {Assets#classify}: the shared asset fields with exactly one of
  # `content:` (a whole file), `part:` (the first part of a multipart upload) or `url:` (a page or
  # file CalmLens fetches).
  type upload_options = {
                          name: String,
                          content: upload_content,
                          ?description: String?,
                          ?visibility: asset_visibility?,
                          ?metadata: Array[metadata_item_input]?,
                          # Tags for the asset, such as `['catalogue', 'backpacks']`.
                          ?tags: Array[String]?,
                          ?author_id: String,
                          ?context: moderation_context_input,
                          ?external_id: String?,
                          ?external_url: String?,
                          ?folder_id: String?,
                          ?upload_preset_id: String,
                          ?processing_options: processing_options_input?,
                          ?request_options: request_options
                        }
                      | {
                          name: String,
                          part: upload_first_part,
                          ?total_size_in_bytes: Integer,
                          ?description: String?,
                          ?visibility: asset_visibility?,
                          ?metadata: Array[metadata_item_input]?,
                          # Tags for the asset, such as `['catalogue', 'backpacks']`.
                          ?tags: Array[String]?,
                          ?author_id: String,
                          ?context: moderation_context_input,
                          ?external_id: String?,
                          ?external_url: String?,
                          ?folder_id: String?,
                          ?upload_preset_id: String,
                          ?processing_options: processing_options_input?,
                          ?request_options: request_options
                        }
                      | {
                          name: String,
                          url: String,
                          ?description: String?,
                          ?visibility: asset_visibility?,
                          ?metadata: Array[metadata_item_input]?,
                          # Tags for the asset, such as `['catalogue', 'backpacks']`.
                          ?tags: Array[String]?,
                          ?author_id: String,
                          ?context: moderation_context_input,
                          ?external_id: String?,
                          ?external_url: String?,
                          ?folder_id: String?,
                          ?upload_preset_id: String,
                          ?processing_options: processing_options_input?,
                          ?request_options: request_options
                        }
  # `wait` overrides whether the final part waits for the decision, chosen when the upload started.
  type upload_part_options = { asset_id: String, part: upload_part, ?wait: bool, ?request_options: request_options }

  # Options of {Text#classify}: the text, with the shared asset fields. `name` defaults to `text`.
  type moderate_text_options = {
    text: String,
    ?name: String,
    ?description: String?,
    ?visibility: asset_visibility?,
    ?metadata: Array[metadata_item_input]?,
    ?tags: Array[String]?,
    ?author_id: String,
    ?context: moderation_context_input,
    ?external_id: String?,
    ?external_url: String?,
    ?folder_id: String?,
    ?upload_preset_id: String,
    ?processing_options: processing_options_input?,
    ?request_options: request_options
  }

  # Options of {UploadTokens#sign}.
  type sign_upload_token_options = {
    upload_preset_id: String,
    ?external_id: String,
    # Seconds the token can start an upload, 1 to 3600; 600 by default.
    ?expires_in: Integer,
    ?request_options: request_options
  }
  type signed_upload_token = { "token" => String, "expiresAt" => Integer }

  type list_folders_options = {
    ?parent_id: String,
    ?cursor: String,
    # 1 to 100, default 50.
    ?page_size: Integer,
    # `name` (the default) or `createdAt`, descending when prefixed with `-`.
    ?sort: sort,
    ?search: String,
    ?request_options: request_options
  }
  type folder_page = {
    "items" => Array[folder],
    "ancestors" => Array[folder],
    "hasMore" => bool,
    "nextCursor" => String?
  }
  type folder_id_options = { folder_id: String, ?request_options: request_options }
  type create_folder_options = { name: String, ?parent_id: String?, ?request_options: request_options }
  type update_folder_options = { folder_id: String, ?name: String, ?request_options: request_options }
  type move_folder_options = { folder_id: String, parent_id: String?, ?request_options: request_options }
  # 1 to 100 lists per page, default 50; `sort` is `createdAt` and `id`, `-createdAt` by default.
  type list_hash_lists_options = { ?cursor: String, ?page_size: Integer, ?sort: sort, ?request_options: request_options }
  type hash_list_page = {
    "items" => Array[hash_list],
    "hasMore" => bool,
    "nextCursor" => String?
  }
  type hash_list_id_options = { hash_list_id: String, ?request_options: request_options }
  type create_hash_list_options = { name: String, action: hash_list_action, ?description: String?, ?request_options: request_options }
  type update_hash_list_options = { hash_list_id: String, ?name: String, ?description: String?, ?action: hash_list_action,
                                    ?request_options: request_options }
  type list_hash_list_entries_options = { hash_list_id: String, ?cursor: String, ?page_size: Integer, ?sort: sort,
                                          ?request_options: request_options }
  type add_hash_list_entry_options = { hash_list_id: String, ?hash: String, ?quality: number, ?asset_id: String, ?label: String,
                                       ?request_options: request_options }
  type hash_list_entry_id_options = { entry_id: String, ?request_options: request_options }

  # Policy settings as options: snake_case Symbol keys, or a policy's `settings` as the API returned it.
  type policy_rule_input = { when: Array[String], action: flagged_content_action, ?name: String, ?unless: Array[String] }
  # Every category needs its `action`, `allowances` and `restrictions`.
  type category_policy_settings_input = {
    action: flagged_content_action,
    allowances: Array[policy_rule_input],
    restrictions: Array[policy_rule_input]
  }
  type link_safety_settings_input = {
    verdict_actions: Hash[String | Symbol, link_safety_action],
    ?off_platform_links: { action: "limit" | "age-restrict" | "block", allowed_domains: Array[String] }
  }
  type policy_settings_input = policy_settings | {
    category_settings: Hash[String | Symbol, category_policy_settings_input],
    ?link_safety: link_safety_settings_input
  }
  # `sort` is `createdAt` and `id`, `createdAt` (oldest first) by default.
  type list_policies_options = { ?cursor: String, ?page_size: Integer, ?sort: sort, ?request_options: request_options }
  type request_only_options = { ?request_options: request_options }
  type policy_id_options = { policy_id: String, ?request_options: request_options }
  # Send `settings` (defining every category) with a `name`, or `preset_id` to copy the latest
  # release of a built-in preset, named after it unless you give a `name`.
  type create_policy_options = { ?name: String, ?description: String, ?settings: policy_settings_input,
                                 ?preset_id: policy_preset_id, ?request_options: request_options }
  type update_policy_options = { policy_id: String, revision: Integer, ?name: String, ?description: String,
                                 ?settings: policy_settings_input, ?request_options: request_options }
  # `reset` restores the pinned release (send `preset.version`); `upgrade` moves an unchanged
  # `pinned` or `copy` policy to the latest release (send `preset.latestVersion`).
  type restore_policy_options = { policy_id: String, revision: Integer, preset_version: Integer,
                                  ?request_options: request_options }
  type set_policy_automatic_updates_options = { policy_id: String, enabled: bool, revision: Integer,
                                                preset_version: Integer, ?request_options: request_options }
  type assign_policy_options = { policy_id: String, ?request_options: request_options }

  # `page_size` is 1 to 100, default 50. `types` and `asset_id` narrow the feed; a cursor belongs to
  # the filters it was issued with.
  type list_events_options = { ?cursor: String, ?page_size: Integer, ?types: Array[event_type], ?asset_id: String,
                               ?request_options: request_options }

  type ensure_lenses_options = { lenses: Array[lens_definition], ?request_options: request_options }
  type ensure_lens_options = {
    identifier: String,
    name: String,
    type: lens_type,
    ?active: bool,
    ?description: String?,
    ?transform: image_transform_options_input?,
    ?request_options: request_options
  }
  # `sort` is `createdAt` and `id`, `-createdAt` (newest first) by default.
  type list_lenses_options = { ?cursor: String, ?page_size: Integer, ?sort: sort, ?request_options: request_options }
  type lens_id_options = { lens_id: String, ?request_options: request_options }
  # The identifier must be new to the project.
  type create_lens_options = ensure_lens_options
  type update_lens_options = {
    lens_id: String,
    ?name: String,
    ?description: String?,
    ?type: lens_type,
    ?active: bool,
    ?transform: image_transform_options_input?,
    ?request_options: request_options
  }

  # `sort` is `createdAt` and `id`, `createdAt` (oldest first) by default.
  type list_upload_presets_options = { ?cursor: String, ?page_size: Integer, ?sort: sort, ?request_options: request_options }
  # One preset's whole definition, by `key`; fields left out take their defaults. Send the `revision`
  # you read (0 for a preset that must not exist yet) to refuse a change made since.
  type upload_preset_definition = {
    key: String,
    name: String,
    ?revision: Integer,
    ?access: upload_preset_access,
    ?enabled: bool,
    ?allowed_content_types: Array[String]?,
    ?max_size_in_bytes: Integer?,
    ?folder_id: String?,
    ?policy_id: String?,
    ?visibility: asset_visibility,
    ?processing_options: processing_options_input?,
    ?reveal_decision: bool,
    ?daily_upload_limit: Integer?,
    ?allowed_origins: Array[String]?
  }
  type ensure_upload_presets_options = { upload_presets: Array[upload_preset_definition], ?request_options: request_options }
  type upload_preset_id_options = { upload_preset_id: String, ?request_options: request_options }
  # The complete settings: those left out return to their defaults.
  type project_settings_input = {
    ?opt_out_jurisdictions: Array[String],
    ?retain_content: bool,
    ?block_unmoderated_assets: bool,
    ?store_sensitive_metadata: bool,
    ?streaming_enabled: bool,
    ?ai_media_search_enabled: bool,
    ?remote_url_rule: { mode: "allow" | "deny", domains: Array[String] }?,
    ?website_submissions_per_minute: Integer?,
    ?human_review: {
      ?allowed_sample_percent: number,
      ?restricted_sample_percent: number,
      ?uncertainty_margin_percent: number,
      ?review_missing_evidence: bool
    }
  }
  # Send the `revision` you read to refuse settings changed since. `search_indexing_budget_units` is
  # needed when turning on `ai_media_search_enabled`.
  type update_project_settings_options = {
    ?revision: Integer,
    settings: project_settings_input,
    ?search_indexing_budget_units: number,
    ?request_options: request_options
  }
  type metadata_field_input = {
    id: String,
    title: String,
    ?description: String,
    type: metadata_field_type,
    icon: metadata_field_icon,
    color: String
  }
  # Fields to create or replace by ID; other fields are kept.
  type ensure_metadata_fields_options = { ?revision: Integer, fields: Array[metadata_field_input], ?request_options: request_options }
  type delete_metadata_field_options = { field_id: String, ?revision: Integer, ?request_options: request_options }

  type asset_url_options = {
    # Exactly one of `asset_id` and `external_id`.
    ?asset_id: String,
    ?external_id: String,
    # The client's project by default.
    ?project_id: String,
    # Without one, the URL is the asset URL itself. `original`, `hls` (the HLS master playlist),
    # `embed` (the page that shows the asset), `placeholder` (a small blurred PNG) and `info` take no
    # lens or transform; `preview` takes them, and `rendered` does when it is an image.
    ?resource: cdn_resource,
    # Transform options replace the lens's options of the same name; both need a resource.
    ?lens: String,
    ?transform: transform_input,
    # Unsigned viewer assertions, sent as the `viewerClaims` query without the defaults. Set
    # `age_confirmed` only where your app has already decided the viewer may see age-restricted content.
    ?viewer_claims: viewer_claims,
    ?request_options: request_options
  }
  type serve_options = {
    ?asset_id: String,
    ?external_id: String,
    ?project_id: String,
    ?viewer_claims: viewer_claims,
    # `rendered` by default.
    ?resource: cdn_resource,
    ?lens: String,
    ?transform: transform_input,
    ?init: { ?method: "GET" | "HEAD", ?headers: Hash[String, String] },
    ?request_options: request_options
  }

  # Options of {MockServerClient#enqueue_event}. Omitted fields are filled in.
  type mock_event_input = {
    type: event_type,
    ?id: String,
    ?project_id: String,
    # The mock API key (`{ 'type' => 'api-key', 'id' => nil }`) when omitted.
    ?actor: actor_input,
    ?severity: event_severity,
    ?title: String,
    ?description: String?,
    ?asset_id: String?,
    ?asset: {
      id: String,
      ?external_id: String?,
      upload: { status: "uploading" | "completed" },
      classification: { status: asset_classification_status, moderation: { status: asset_moderation_status } },
      content: { status: asset_content_status }
    }?,
    ?facts: Array[event_fact_input],
    ?created_at: Integer
  }
end
