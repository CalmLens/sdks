# Public API of the calmlens gem. Request and response shapes are in sig/types.rbs and error codes
# in sig/error_codes.rbs.
module CalmLens
  VERSION: String

  WEBHOOK_DELIVERY_HEADER: String
  WEBHOOK_TIMESTAMP_HEADER: String
  WEBHOOK_SIGNATURE_HEADER: String
  WEBHOOK_SIGNATURE_TOLERANCE_SECONDS: Integer

  module SdkErrorCodes
    INVALID_ARGUMENT: String
    INVALID_CONFIG: String
    TRANSPORT_ERROR: String
    TIMEOUT: String
    INVALID_RESPONSE: String
    HTTP_ERROR: String
    RESPONSE_TOO_LARGE: String
    CANCELLED: String
    INVALID_WEBHOOK_SIGNATURE: String
    INVALID_WEBHOOK_PAYLOAD: String
  end

  class Error < StandardError
    attr_reader code: String
    # The API error's details (any JSON), such as validation `issues`, or nil when it has none.
    attr_reader details: Hash[String, json_value]?
    attr_reader status: Integer?
    attr_reader request_id: String?
    attr_reader headers: Hash[String, String]
    # The error response's body as received, at most BODY_LIMIT bytes; nil without a response.
    attr_reader body: String?
    # The request's HTTP method and URL, for an API error response.
    attr_reader http_method: String?
    attr_reader url: String?
    BODY_LIMIT: Integer
    def initialize: (String code, ?String? message, ?details: Hash[String, json_value]?, ?status: Integer?,
                     ?headers: Hash[String, String], ?request_id: String?, ?body: String?, ?http_method: String?,
                     ?url: String?) -> void
    # Whole seconds from the `Retry-After` header.
    def retry_after: () -> Integer?
    def local?: () -> bool
    def not_found?: () -> bool
    def retryable?: () -> bool
    def self.build: (String code, ?String? message, ?status: Integer?, ?details: Hash[String, json_value]?,
                     ?headers: Hash[String, String], ?request_id: String?) -> Error
  end
  class APIError < Error end
  class BadRequestError < APIError end
  class AuthenticationError < APIError end
  class PermissionDeniedError < APIError end
  class NotFoundError < APIError end
  class ConflictError < APIError end
  class PayloadTooLargeError < APIError end
  class UnprocessableEntityError < APIError end
  class RateLimitError < APIError end
  class ServerError < APIError end
  class ConnectionError < Error end
  class TimeoutError < Error end
  class CancelledError < Error end
  class InvalidResponseError < Error end
  class InvalidArgumentError < Error end
  class ConfigurationError < InvalidArgumentError end
  class WebhookVerificationError < Error end

  # A read-only API object. Fields have snake_case readers and can be read with `[]` by reader name
  # or API key; to_h is the API's JSON form.
  # What the API answered to the request that returned a result.
  class LastResponse
    attr_reader status: Integer
    attr_reader headers: Hash[String, String]
    attr_reader request_id: String?
    attr_reader idempotency_key: String?
    def initialize: (status: Integer, headers: Hash[String, String], request_id: String?, idempotency_key: String?) -> void
  end

  class Model
    def initialize: (Hash[String, untyped] values, ?last_response: LastResponse?) -> void
    # The response that returned this result; nil for an object inside one.
    attr_reader last_response: LastResponse?
    def []: (Symbol | String key) -> untyped
    def key?: (Symbol | String key) -> bool
    def dig: (Symbol | String key, *untyped rest) -> untyped
    def values_at: (*(Symbol | String) keys) -> Array[untyped]
    def keys: () -> Array[Symbol]
    def to_h: () -> Hash[String, json_value]
    def deconstruct_keys: (Array[Symbol]? keys) -> Hash[Symbol, untyped]
    def to_json: (*untyped) -> String
    def ==: (untyped other) -> bool
    def eql?: (untyped other) -> bool
    def hash: () -> Integer
  end

  # One page of a list; enumerating it yields this page's items.
  class Page[T] < Model
    include Enumerable[T]
    def initialize: (Hash[String, untyped] values, ?fetch: (^(String cursor) -> Page[T])?, ?cursor: String?,
                     ?last_response: LastResponse?) -> void
    def each: () { (T) -> void } -> self
            | () -> Enumerator[T, self]
    def empty?: () -> bool
    def next_page?: () -> bool
    def next_page: () -> self
    def each_page: () { (self) -> void } -> nil
                 | () -> Enumerator[self, nil]
    def auto_paging_each: () { (T) -> void } -> nil
                        | () -> Enumerator[T, nil]
  end

  class Response
    attr_reader status: Integer
    attr_reader headers: Hash[String, String]
    # Give `body:` for a complete body, or a reader block that yields each String chunk to the
    # block it receives. RBS cannot describe a block that takes a block, hence `(?)`.
    def initialize: (status: Integer | String, ?headers: Hash[String | Symbol, String | Array[String]], ?body: String?)
                    ?{ (?) -> void } -> void
    def request_id: () -> String?
    def content_type: () -> String?
    def content_length: () -> Integer?
    def success?: () -> bool
    def each_chunk: () { (String chunk) -> void } -> nil
                  | () -> Enumerator[String, nil]
    def body: (?limit: Integer?) -> String
  end

  module Transport
    class Request < Struct[untyped]
      attr_accessor method: String
      attr_accessor url: String
      attr_accessor headers: Hash[String, String]
      attr_accessor body: (String | _Reader)?
      attr_accessor open_timeout: number
      attr_accessor timeout: number
      def initialize: (method: String, url: String, headers: Hash[String, String], body: (String | _Reader)?,
                       open_timeout: number, timeout: number) -> void
    end

    interface _Reader
      def read: (?Integer? length, ?String? buffer) -> String?
    end

    # A custom transport receives each request and either yields a {Response} to the block (and
    # returns the block's result) or returns a response: a {Response}, or any object with `status`
    # (or `code`), `headers` (or `to_hash`) and `body`. The return value is untyped because the
    # client only inspects it when the transport did not yield.
    interface _Transport
      def call: (Request request) { (Response response) -> untyped } -> untyped
    end

    class NetHTTP
      def initialize: () -> void
      # Returns the block's result.
      def call: [T] (Request request) { (Response response) -> T } -> T?
      def close: () -> void
    end
  end

  class ServerClient
    DEFAULT_BASE_URL: String
    DEFAULT_CDN_BASE_URL: String
    DEFAULT_TIMEOUT: Integer
    DEFAULT_OPEN_TIMEOUT: Integer
    DEFAULT_MAX_RETRIES: Integer
    DEFAULT_RETRY_BASE_DELAY: Float
    DEFAULT_MAX_RETRY_DELAY: Integer
    RETRY_AFTER_MAX: Integer
    DEFAULT_MAX_RESPONSE_BYTES: Integer
    DEFAULT_PART_SIZE_BYTES: Integer
    MIN_PART_SIZE_BYTES: Integer
    MAX_PART_SIZE_BYTES: Integer
    ENSURE_LENSES_MAX_PER_REQUEST: Integer
    attr_reader assets: Assets
    attr_reader folders: Folders
    attr_reader hash_lists: HashLists
    attr_reader policies: Policies
    attr_reader text: Text
    attr_reader upload_tokens: UploadTokens
    attr_reader events: Events
    attr_reader cdn: CDN
    attr_reader lenses: Lenses
    attr_reader upload_presets: UploadPresets
    attr_reader project_settings: ProjectSettings
    attr_reader metadata_fields: MetadataFields
    attr_reader project_id: String
    attr_reader base_url: String
    attr_reader cdn_base_url: String
    def initialize: (?api_key: String?, ?project_id: String?, ?base_url: String, ?cdn_base_url: String, ?timeout: number,
                     ?open_timeout: number, ?upload_timeout: number?, ?max_retries: Integer, ?retry_base_delay: number,
                     ?max_retry_delay: number, ?max_response_bytes: Integer, ?part_size_bytes: Integer,
                     ?transport: Transport::_Transport?, ?app_info: app_info?, ?logger: _Logger?, ?log_level: ("info" | "debug")?,
                     ?on_request: (^(request_event event) -> void)?) -> void
    def close: () -> nil
    # Sends a request to any API path with the client's authentication, retries and error mapping.
    def request: (String method, String path, ?query: Hash[String | Symbol, untyped], ?body: Hash[String | Symbol, untyped]?,
                  ?headers: Hash[String, String], ?request_options: request_options) -> (Model | json_value)
    def ensure_lenses: (lenses: Array[lens_definition], ?request_options: request_options) -> Array[Lens]
    def ensure_lens: (identifier: String, name: String, type: lens_type, ?active: bool, ?description: String?, ?transform: image_transform_options_input?, ?request_options: request_options) -> Lens
  end

  # Your integration's name, version and URL, added to the User-Agent.
  type app_info = { name: String, ?version: String, ?url: String }
  # One request attempt, as ServerClient's `on_request:` hook receives it.
  type request_event = { operation: String?, method: String, path: String?, attempt: Integer, delay: number?,
                         status: Integer?, request_id: String?, error_code: String?, duration: Float }

  # A Ruby Logger, or anything with `info` and `debug` taking a block.
  interface _Logger
    def info: () { () -> String } -> untyped
    def debug: () { () -> String } -> untyped
  end

  class Resource
    # Resources are created by {ServerClient}; the session is internal.
    private def initialize: (untyped session) -> void
  end

  # The earlier posts CalmLens uses from an upload's `context`.
  module ModerationContext
    # The most recent earlier posts CalmLens uses.
    USED_ITEMS: Integer
    # The most characters (Unicode code points) of earlier posts CalmLens uses.
    USED_CHARACTERS: Integer
    # The most recent posts within USED_ITEMS and USED_CHARACTERS, oldest first; the newest is always kept.
    def self.select_items: (Array[moderation_context_item_input | Hash[String | Symbol, untyped]] items) -> Array[moderation_context_item]
  end

  class Assets < Resource
    # The classification statuses of a settled asset; wait_for_decision returns at the first.
    SETTLED_STATUSES: Array[String]
    DECISION_POLL_FIRST_DELAY: Float
    DECISION_POLL_FACTOR: Float
    DECISION_POLL_MAX_DELAY: Float
    DEFAULT_DECISION_TIMEOUT: Integer
    BATCH_OPERATIONS: Array[asset_batch_operation]
    MAX_BATCH_ASSETS: Integer

    def search: (query: String, ?mode: asset_search_mode, ?page_size: Integer, ?request_options: request_options) -> AssetSearchResult
    def list: (?cursor: String, ?page_size: Integer, ?sort: sort, ?filter: String?, ?request_options: request_options) -> AssetPage
    def list_children: (String asset_id, ?cursor: String, ?page_size: Integer, ?sort: sort, ?request_options: request_options) -> AssetPage
    def list_timeline: (String asset_id, ?cursor: String, ?page_size: Integer, ?request_options: request_options) -> AssetTimelinePage
    def retrieve: (String asset_id, ?request_options: request_options) -> Asset
    def wait_for_decision: (String asset_id, ?timeout: number, ?request_options: request_options) -> Asset
    def update: (String asset_id, ?name: String, ?description: String?, ?external_id: String?, ?external_url: String?, ?metadata: Array[metadata_item_input]?, ?tags: Array[String]?, ?visibility: asset_visibility?, ?request_options: request_options) -> Asset
    def retry: (String asset_id, ?request_options: request_options) -> Asset
    def decide: (String asset_id, decision: "allowed" | "limited" | "age-restricted" | "blocked" | "purged", note: String, ?confirm_purge: true, ?request_options: request_options) -> Asset
    def explain: (String asset_id, ?rerun: bool, ?request_options: request_options) -> Asset
    def remove_content: (String asset_id, ?request_options: request_options) -> Asset
    def delete: (String asset_id, ?request_options: request_options) -> nil
    def batch: (asset_ids: Array[String], operation: asset_batch_operation, ?request_options: request_options) -> AssetBatch
    def move: (String asset_id, folder_id: String?, ?request_options: request_options) -> Asset
    def create: (name: String, content: upload_content, ?description: String?, ?visibility: asset_visibility?, ?metadata: Array[metadata_item_input]?, ?tags: Array[String]?, ?author_id: String, ?context: moderation_context_input, ?external_id: String?, ?external_url: String?, ?folder_id: String?, ?upload_preset_id: String, ?processing_options: processing_options_input?, ?request_options: request_options) -> Asset
               | (name: String, part: upload_first_part, ?total_size_in_bytes: Integer, ?description: String?, ?visibility: asset_visibility?, ?metadata: Array[metadata_item_input]?, ?tags: Array[String]?, ?author_id: String, ?context: moderation_context_input, ?external_id: String?, ?external_url: String?, ?folder_id: String?, ?upload_preset_id: String, ?processing_options: processing_options_input?, ?request_options: request_options) -> Asset
               | (name: String, url: String, ?description: String?, ?visibility: asset_visibility?, ?metadata: Array[metadata_item_input]?, ?tags: Array[String]?, ?author_id: String, ?context: moderation_context_input, ?external_id: String?, ?external_url: String?, ?folder_id: String?, ?upload_preset_id: String, ?processing_options: processing_options_input?, ?request_options: request_options) -> Asset
    def classify: (name: String, content: upload_content, ?description: String?, ?visibility: asset_visibility?, ?metadata: Array[metadata_item_input]?, ?tags: Array[String]?, ?author_id: String, ?context: moderation_context_input, ?external_id: String?, ?external_url: String?, ?folder_id: String?, ?upload_preset_id: String, ?processing_options: processing_options_input?, ?request_options: request_options) -> Asset
                 | (name: String, part: upload_first_part, ?total_size_in_bytes: Integer, ?description: String?, ?visibility: asset_visibility?, ?metadata: Array[metadata_item_input]?, ?tags: Array[String]?, ?author_id: String, ?context: moderation_context_input, ?external_id: String?, ?external_url: String?, ?folder_id: String?, ?upload_preset_id: String, ?processing_options: processing_options_input?, ?request_options: request_options) -> Asset
                 | (name: String, url: String, ?description: String?, ?visibility: asset_visibility?, ?metadata: Array[metadata_item_input]?, ?tags: Array[String]?, ?author_id: String, ?context: moderation_context_input, ?external_id: String?, ?external_url: String?, ?folder_id: String?, ?upload_preset_id: String, ?processing_options: processing_options_input?, ?request_options: request_options) -> Asset
    def upload_part: (String asset_id, part: upload_part, ?wait: bool, ?request_options: request_options) -> Asset
    # Waits between decision checks; a mock client's waits take no real time.
    private def sleep: (Numeric seconds) -> void
  end

  class Folders < Resource
    def list: (?parent_id: String, ?cursor: String, ?page_size: Integer, ?sort: sort, ?search: String, ?request_options: request_options) -> FolderPage
    def create: (name: String, ?parent_id: String?, ?request_options: request_options) -> Folder
    def retrieve: (String folder_id, ?request_options: request_options) -> Folder
    def update: (String folder_id, ?name: String, ?request_options: request_options) -> Folder
    def move: (String folder_id, parent_id: String?, ?request_options: request_options) -> Folder
    def delete: (String folder_id, ?request_options: request_options) -> nil
  end

  class HashLists < Resource
    def list: (?cursor: String, ?page_size: Integer, ?sort: sort, ?request_options: request_options) -> HashListPage
    def retrieve: (String hash_list_id, ?request_options: request_options) -> HashList
    def create: (name: String, action: hash_list_action, ?description: String?, ?request_options: request_options) -> HashList
    def update: (String hash_list_id, ?name: String, ?description: String?, ?action: hash_list_action, ?request_options: request_options) -> HashList
    def delete: (String hash_list_id, ?request_options: request_options) -> nil
    def list_entries: (String hash_list_id, ?cursor: String, ?page_size: Integer, ?sort: sort, ?request_options: request_options) -> HashListEntryPage
    def add_entry: (String hash_list_id, ?hash: String, ?quality: number, ?asset_id: String, ?label: String, ?request_options: request_options) -> HashListEntry
    def remove_entry: (String entry_id, ?request_options: request_options) -> nil
  end

  class Policies < Resource
    def list: (?cursor: String, ?page_size: Integer, ?sort: sort, ?request_options: request_options) -> PolicyPage
    def retrieve: (String policy_id, ?request_options: request_options) -> Policy
    # The policy the project moderates with.
    def retrieve_assigned: (?request_options: request_options) -> Policy
    def create: (?name: String, ?description: String, ?settings: policy_settings_input, ?preset_id: policy_preset_id, ?request_options: request_options) -> Policy
    def update: (String policy_id, revision: Integer, ?name: String, ?description: String, ?settings: policy_settings_input, ?request_options: request_options) -> Policy
    def reset: (String policy_id, revision: Integer, preset_version: Integer, ?request_options: request_options) -> Policy
    def upgrade: (String policy_id, revision: Integer, preset_version: Integer, ?request_options: request_options) -> Policy
    def set_automatic_updates: (String policy_id, enabled: bool, revision: Integer, preset_version: Integer, ?request_options: request_options) -> Policy
    def delete: (String policy_id, ?request_options: request_options) -> nil
    def assign: (policy_id: String, ?request_options: request_options) -> Policy
  end

  class Lenses < Resource
    # ServerClient#ensure_lenses and #ensure_lens call these.
    private def ensure_lenses: (lenses: Array[lens_definition], ?request_options: request_options) -> Array[Lens]
    private def ensure_lens: (identifier: String, name: String, type: lens_type, ?active: bool, ?description: String?, ?transform: image_transform_options_input?, ?request_options: request_options) -> Lens
    def list: (?cursor: String, ?page_size: Integer, ?sort: sort, ?request_options: request_options) -> LensPage
    def create: (identifier: String, name: String, type: lens_type, ?active: bool, ?description: String?, ?transform: image_transform_options_input?, ?request_options: request_options) -> Lens
    def retrieve: (String lens_id, ?request_options: request_options) -> Lens
    def update: (String lens_id, ?name: String, ?description: String?, ?type: lens_type, ?active: bool, ?transform: image_transform_options_input?, ?request_options: request_options) -> Lens
    def delete: (String lens_id, ?request_options: request_options) -> nil
  end

  class UploadPresets < Resource
    def list: (?cursor: String, ?page_size: Integer, ?sort: sort, ?request_options: request_options) -> UploadPresetPage
    def ensure: (upload_presets: Array[upload_preset_definition], ?request_options: request_options) -> UploadPresetsEnsured
    def delete: (String upload_preset_id, ?request_options: request_options) -> nil
  end

  class ProjectSettings < Resource
    def get: (?request_options: request_options) -> ProjectSettingsResource
    def update: (?revision: Integer, settings: project_settings_input, ?search_indexing_budget_units: number, ?request_options: request_options) -> ProjectSettingsResource
  end

  class MetadataFields < Resource
    def list: (?request_options: request_options) -> MetadataFieldsResource
    def ensure: (?revision: Integer, fields: Array[metadata_field_input], ?request_options: request_options) -> MetadataFieldsResource
    def delete: (String field_id, ?revision: Integer, ?request_options: request_options) -> nil
  end

  class UploadTokens < Resource
    TOKEN_PREFIX: String
    SIGNING_CONTEXT: String
    DEFAULT_TTL_SECONDS: Integer
    MAX_TTL_SECONDS: Integer
    private def initialize: (untyped session, String api_key) -> void
    def sign: (upload_preset_id: String, ?external_id: String, ?expires_in: Integer, ?request_options: request_options) -> SignedUploadToken
  end

  class Text < Resource
    private def initialize: (untyped session, Assets assets) -> void
    def classify: (text: String, ?name: String, ?description: String?, ?visibility: asset_visibility?, ?metadata: Array[metadata_item_input]?, ?tags: Array[String]?, ?author_id: String, ?context: moderation_context_input, ?external_id: String?, ?external_url: String?, ?folder_id: String?, ?upload_preset_id: String, ?processing_options: processing_options_input?, ?request_options: request_options) -> Asset
  end

  class Events < Resource
    def list: (?cursor: String, ?page_size: Integer, ?types: Array[event_type], ?asset_id: String, ?request_options: request_options) -> EventPage
  end

  class CDN < Resource
    # Every CDN resource beneath an asset URL.
    RESOURCES: Array[cdn_resource]
    # A signed asset URL's lifetime in seconds when `expires_in` is omitted.
    DEFAULT_SIGNED_URL_EXPIRES_IN: Integer
    # The longest signed asset URL lifetime, in seconds.
    MAX_SIGNED_URL_EXPIRES_IN: Integer
    # The start of the asset segment that names an asset by its external ID.
    EXTERNAL_ID_PREFIX: String
    # The ISO 3166-1 alpha-2 countries a viewer's `region` can be.
    VIEWER_COUNTRIES: Array[String]
    def get_asset_url: (?asset_id: String, ?external_id: String, ?project_id: String, ?resource: cdn_resource, ?lens: String, ?transform: transform_input, ?viewer_claims: viewer_claims, ?request_options: request_options) -> String
    def sign_asset_url: (?asset_id: String, ?external_id: String, ?project_id: String, ?expires_in: Integer, ?original: bool, ?resource: cdn_resource, ?lens: String, ?transform: transform_input, ?viewer_claims: viewer_claims, ?request_options: request_options) -> SignedAssetUrl
    def get_asset_info: (String url, ?viewer_claims: viewer_claims?) -> AssetInfo
    def serve: (?asset_id: String, ?external_id: String, ?project_id: String, ?viewer_claims: viewer_claims, ?resource: cdn_resource, ?lens: String, ?transform: transform_input, ?init: { ?method: "GET" | "HEAD", ?headers: Hash[String, String] }, ?request_options: request_options) -> Response
             | [T] (?asset_id: String, ?external_id: String, ?project_id: String, ?viewer_claims: viewer_claims, ?resource: cdn_resource, ?lens: String, ?transform: transform_input, ?init: { ?method: "GET" | "HEAD", ?headers: Hash[String, String] }, ?request_options: request_options) { (Response) -> T } -> T
  end

  class Event
    # Whether the event is a test send from the portal or CLI.
    def test?: () -> bool
    # Whether to apply this event after `last_sequence`, the highest `asset_sequence` applied for its asset.
    def newer_than?: (Integer? last_sequence) -> bool
  end

  # The display info of an asset URL, from CDN#get_asset_info.
  class AssetInfo < Model
    class Content < Model
      def format: () -> String?
      def width: () -> Integer?
      def height: () -> Integer?
      def duration_seconds: () -> Float?
      def page_count: () -> Integer?
      def rendered: () -> Asset::Content::Rendered?
      def preview: () -> Asset::Content::Preview?
      def hls: () -> Asset::Content::Hls?
    end

    def id: () -> String
    def project_id: () -> String
    def type: () -> asset_type
    def external_url: () -> String?
    def content: () -> Content
    def availability: () -> asset_availability
  end

  # A signed upload token from UploadTokens#sign.
  class SignedUploadToken < Model
    def token: () -> String
    # Milliseconds since the Unix epoch.
    def expires_at: () -> Integer
  end

  # Request headers to read webhook headers from: names in any case, repeated values as an Array
  # (`Net::HTTPHeader#to_hash`), or a Rack env.
  type webhook_headers = Hash[String | Symbol, String | Array[String]] | _ToHash

  interface _ToHash
    def to_hash: () -> Hash[String, String | Array[String]]
  end

  module Webhooks
    def self.signature_header: (payload: String, timestamp: String | Integer, secret: String) -> String
    def self.headers: (payload: String, delivery_id: String, secret: String, ?timestamp: Integer) -> Hash[String, String]
    def self.to_payload: (Event | Hash[String, untyped] event) -> Hash[String, json_value]
    def self.verify: (payload: String, secret: String, ?signature: String?, ?timestamp: String?, ?headers: webhook_headers?,
                      ?tolerance_seconds: Integer, ?now: number) -> bool
    def self.verify_request: (payload: String, headers: webhook_headers, secret: String, ?tolerance_seconds: Integer,
                              ?now: number) -> bool
    def self.parse_event: (payload: String, secret: String, ?signature: String?, ?timestamp: String?, ?headers: webhook_headers?,
                           ?tolerance_seconds: Integer, ?now: number) -> Event
    def self.test_event?: (Event | Hash[String, untyped] event) -> bool
    def self.newer_asset_event?: (Event | Hash[String, untyped] event, Integer? last_sequence) -> bool
  # The value of an event's fact by key (the first, when the event repeats it), or nil without one.
  def self.get_event_fact: (Event | Hash[String, untyped] event, String key) -> event_fact_value
  # An event's facts as values by key; a repeated key keeps its first value.
  def self.get_event_facts: (Event | Hash[String, untyped] event) -> Hash[String, event_fact_value]
  end

  module EventFacts
    def self.value: (Event | Hash[String, untyped] event, String key) -> event_fact_value
    def self.values: (Event | Hash[String, untyped] event) -> Hash[String, event_fact_value]
  end

  def self.create_webhook_signature_header: (payload: String, timestamp: String | Integer, secret: String) -> String
  def self.create_webhook_headers: (payload: String, delivery_id: String, secret: String, ?timestamp: Integer) -> Hash[String, String]
  def self.to_webhook_event_payload: (Event | Hash[String, untyped] event) -> Hash[String, json_value]
  def self.verify_webhook_signature: (payload: String, secret: String, ?signature: String?, ?timestamp: String?,
                                      ?headers: webhook_headers?, ?tolerance_seconds: Integer, ?now: number) -> bool
  def self.verify_webhook_request: (payload: String, headers: webhook_headers, secret: String, ?tolerance_seconds: Integer,
                                    ?now: number) -> bool
  def self.parse_webhook_event: (payload: String, secret: String, ?signature: String?, ?timestamp: String?,
                                 ?headers: webhook_headers?, ?tolerance_seconds: Integer, ?now: number) -> Event
  def self.test_webhook_event?: (Event | Hash[String, untyped] event) -> bool
  def self.newer_asset_event?: (Event | Hash[String, untyped] event, Integer? last_sequence) -> bool
  # The value of an event's fact by key (the first, when the event repeats it), or nil without one.
  def self.get_event_fact: (Event | Hash[String, untyped] event, String key) -> event_fact_value
  # An event's facts as values by key; a repeated key keeps its first value.
  def self.get_event_facts: (Event | Hash[String, untyped] event) -> Hash[String, event_fact_value]

  # require 'calmlens/testing'
  module Testing
    # The mock's in-memory records. Change them to arrange a test, such as setting an asset's `classification.moderation.decision`.
    class State < Struct[untyped]
      # The records as the API sends them, with camelCase String keys.
      attr_accessor assets: Hash[String, Hash[String, untyped]]
      attr_accessor folders: Hash[String, Hash[String, untyped]]
      # Stored bytes by asset ID, with each part's bytes by part number.
      attr_accessor content: Hash[String, { "type" => String, "parts" => Hash[Integer, String] }]
      attr_accessor events: Array[Hash[String, untyped]]
      attr_accessor lenses: Hash[String, Hash[String, untyped]]
      attr_accessor hash_lists: Hash[String, Hash[String, untyped]]
      attr_accessor hash_list_entries: Hash[String, Hash[String, untyped]]
    end
  end

  class MockServerClient < ServerClient
    class Request < Struct[untyped]
      attr_accessor method: String
      attr_accessor url: String
      attr_accessor path: String
      attr_accessor query: Hash[String, String]
      attr_accessor headers: Hash[String, String]
      attr_accessor body: String?
      # The HTTP status the mock answered with; nil when the request failed without a response.
      attr_accessor status: Integer?
      def json: () -> json_value
      # An upload form's `options` (parsed) and `file` (its bytes); nil for any other body.
      def form: () -> { 'options' => Hash[String, json_value], 'file' => String }?
    end

    interface _Clock
      # The current time in milliseconds since the Unix epoch.
      def call: () -> Integer
    end

    interface _IdFactory
      def call: (String prefix) -> String
    end

    # Decides each asset the mock moderates: a status or a MockDecision.
    interface _Moderate
      def call: (MockModerationInput input) -> (MockDecision::status | MockDecision)
    end

    API_KEY_PREFIX: String

    # A mock API key carrying permission grants, such as `assets:download` for CDN reads.
    def self.create_api_key: (?Array[Hash[Symbol | String, untyped]] grants) -> String
    # Signs an upload token like UploadTokens#sign at `now` (epoch milliseconds) with `nonce`.
    def self.sign_upload_token: (String api_key, sign_upload_token_options options, now: Integer, nonce: String) -> SignedUploadToken

    REQUEST_FAILURES: Array[String]

    def initialize: (?project_id: String, ?api_key: String, ?base_url: String, ?cdn_base_url: String, ?now: _Clock, ?create_id: _IdFactory,
                     ?moderate: _Moderate?, ?timeout: number,
                     ?open_timeout: number, ?upload_timeout: number?, ?max_retries: Integer, ?retry_base_delay: number, ?max_retry_delay: number,
                     ?max_response_bytes: Integer, ?part_size_bytes: Integer, ?app_info: app_info?, ?logger: _Logger?,
                     ?log_level: ("info" | "debug")?, ?on_request: (^(request_event event) -> void)?) -> void
    # Replaces the mock API key's grants for later requests; the key stays the same.
    def api_key_grants=: (Array[Hash[Symbol | String, untyped]] grants) -> Array[Hash[Symbol | String, untyped]]
    # Fails the next request (or the next one `operation` sends) with `transport-error`, `timeout`, an
    # API error code (with optional `details` and `Retry-After` seconds, which only an API error takes) or
    # an exception.
    def fail_next_request: (?(String | Exception) failure, ?operation: String?, ?details: Hash[String | Symbol, untyped]?,
                            ?retry_after: Integer?) -> self
    def state: () -> Testing::State
    # `body` is any JSON value, encoded as the response body.
    def enqueue: (body: json_input, ?status: Integer, ?headers: Hash[String, String]) -> self
    def enqueue_raw: (body: String, ?status: Integer, ?headers: Hash[String, String]) -> self
    def enqueue_error: (Exception error) -> self
    # Fetches a mock CDN URL with a GET and without the API key, as a browser would.
    def fetch_cdn: (String url) -> Response
    def enqueue_event: (mock_event_input event) -> Event
    # Applies a reviewer's decision and adds the matching `asset.<decision>` event.
    def decide: (String asset_id, asset_moderation_decision decision) -> Asset
    # Finishes processing an asset as the moderation pipeline would, with `decision` or else `moderate`'s answer.
    def complete_processing: (String asset_id, ?(MockDecision::status | MockDecision)? decision) -> Asset
    def requests: () -> Array[Request]
    def clear_requests: () -> self
    def remaining_responses: () -> Integer
  end

  # A moderation decision for MockServerClient's `moderate:` option or `complete_processing`.
  class MockDecision
    # `pending`, `failed` or a decided moderation status.
    type status = "pending" | "failed" | asset_moderation_decision

    STATUSES: Array[String]

    def self.of: (status status) -> MockDecision
    def initialize: (status status) -> void
    def status: () -> status
    # Flags `category` with a score from 0 to 1 and optional qualifier scores.
    def flag: (String | Symbol category, Numeric score, ?Hash[String | Symbol, Numeric] qualifiers) -> self
    def not_evaluated: (String | Symbol category) -> self
    # Leaves the decision waiting for human review: `sampled`, or `uncertain` with the categories that made it so.
    def pending_review: ("sampled" | "uncertain" | :sampled | :uncertain reason, ?Array[String | Symbol] uncertain_categories) -> self
    # The `categories`, `score` and `policy` a decided asset gets; nil for `pending` and `failed`.
    # `requested_at` is when a pending review joined the queue, in epoch milliseconds.
    def report: (?Integer requested_at) -> Hash[String, json_value]?
  end

  # What MockServerClient's `moderate:` callback receives.
  class MockModerationInput < Struct[untyped]
    class Content < Struct[untyped]
      # The uploaded bytes; nil without stored content.
      attr_accessor bytes: String?
      # The bytes as UTF-8 text, for a `plaintext-document`.
      attr_accessor text: String?
    end

    # The stored asset, still processing.
    # The stored asset as the API sends it, still processing.
    attr_accessor asset: Hash[String, untyped]
    attr_accessor content: Content
    attr_accessor trigger: "upload" | "retry" | "rerun" | "complete"
    attr_accessor queued: bool
    def queued?: () -> bool
  end

  # The categories and qualifiers MockDecision accepts.
  module MockClassification
    CATEGORIES: Array[String]
    QUALIFIERS: Hash[String, Array[String]]
    # Qualifiers the input type sets, which a TestInputs scenario cannot list.
    INPUT_QUALIFIERS: Array[String]
    # Test scenario detections: entries per list, the basis points of a full side, the oldest age
    # and the age presets.
    TEST_DETECTIONS_MAX: Integer
    TEST_DETECTION_BOX_MAX: Integer
    TEST_FACE_AGE_MAX: Integer
    TEST_FACE_AGE_PRESETS: Array[String]
  end

  # Signed test inputs: text codes, test images and media phrases signed with a project's secret
  # test input key from the portal.
  module TestInputs
    type action = "allow" | "limit" | "age-restrict" | "block"
    type region = moderation_region
    type regional_action = { "region" => region, "action" => "limit" | "age-restrict" | "block" }
    # One qualifying instance; set an action on every instance or on none.
    type test_instance = { "category" => classification_category, ?"score" => number, ?"action" => action, "qualifiers" => Array[String] }
    # `[left, top, width, height]`: Integers in basis points of the image, 0 to 10000, inside it.
    type detection_box = [Integer, Integer, Integer, Integer]
    # A person a test image reports, with an optional Integer confidence from 0 to 100.
    type test_person = { "box" => detection_box, ?"confidence" => Integer }
    # A face's age: a preset, or a range of Integers from 0 to 120 with `low` at most `high`.
    type test_face_age = "adult" | "minor" | { "low" => Integer, "high" => Integer }
    # A face a test image reports, with an optional confidence and age.
    type test_face = { "box" => detection_box, ?"confidence" => Integer, ?"age" => test_face_age }
    # The people and faces a test image reports: at most 32 of each, or `unavailable` to report the
    # feature as not evaluated.
    type test_detections = { ?"people" => Array[test_person] | "unavailable", ?"faces" => Array[test_face] | "unavailable" }
    # A scenario with String keys; Symbol and snake_case keys are accepted as a plain Hash.
    type scenario = { ?"regionalActions" => Array[regional_action], ?"unassessedCategories" => Array[classification_category],
                      "instances" => Array[test_instance], ?"detections" => test_detections }
    type signal = classification_category | "sexual.involving-minors" | "harassment.insult" | "sexual.adult"
                | "hate.regional-symbol" | "violence.graphic"
    type media_signal = classification_category | "violence.graphic"
    type input = scenario | Hash[String | Symbol, untyped] | signal

    # A painted test image: width by height pixels of 8-bit RGBA in the binary String `rgba`, and
    # the same image as binary PNG bytes in `png`.
    class Image < Struct[untyped]
      attr_accessor width: Integer
      attr_accessor height: Integer
      attr_accessor rgba: String
      attr_accessor png: String
      def initialize: (width: Integer, height: Integer, rgba: String, png: String) -> void
    end

    REGIONS: Array[region]
    SIGNALS: Array[signal]
    MEDIA_SIGNALS: Array[media_signal]
    # clean, limited, adult_image, adult_text, regional_delivery, germany, mixed, one_face, no_face,
    # adult_face, minor_face and group (deeply frozen).
    PRESETS: Hash[Symbol, scenario]

    def self.for_signal: (signal signal, ?("text" | "image") kind) -> scenario
    def self.generate_text_code: (input input, String test_input_key) -> String
    def self.paint_image: (input input, String test_input_key) -> Image
    def self.generate_media_code: (media_signal signal, String test_input_key) -> String
  end
end
