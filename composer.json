{
  "name": "calmlens/sdk",
  "description": "CalmLens PHP SDK for moderation, storage, events and CDN delivery",
  "type": "library",
  "license": "MIT",
  "homepage": "https://calmlens.com/docs/sdk/php",
  "readme": "php/README.md",
  "support": {
    "docs": "https://calmlens.com/docs/sdk/php",
    "issues": "https://github.com/CalmLens/sdks/issues",
    "source": "https://github.com/CalmLens/sdks/tree/main/php"
  },
  "require": {
    "php": "^8.2",
    "ext-hash": "*",
    "ext-json": "*",
    "guzzlehttp/psr7": "^2.7 || ^3.0",
    "php-http/discovery": "^1.19",
    "psr/http-client": "^1.0",
    "psr/http-message": "^2.0"
  },
  "suggest": {
    "guzzlehttp/guzzle": "The HTTP client the SDK uses when none is passed, with per-attempt timeouts; any PSR-18 client works"
  },
  "autoload": {
    "psr-4": {
      "CalmLens\\": "php/src/"
    }
  }
}
