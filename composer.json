{
  "name": "calmlens/sdk",
  "description": "CalmLens PHP SDK for moderation, storage, events and CDN delivery",
  "type": "library",
  "license": "MIT",
  "homepage": "https://calmlens.com/docs/sdk/php",
  "support": {
    "docs": "https://calmlens.com/docs/sdk/php",
    "issues": "https://github.com/CalmLens/sdks/issues",
    "source": "https://github.com/CalmLens/sdks/tree/main/php"
  },
  "require": {
    "php": "~8.2.35 || ~8.3.36 || ~8.4.27 || ^8.5.12",
    "guzzlehttp/guzzle": "^7.9 || ^8.0",
    "guzzlehttp/promises": "^2.0.3 || ^3.0",
    "guzzlehttp/psr7": "^2.7 || ^3.0",
    "psr/http-message": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "CalmLens\\": "php/src/"
    }
  }
